from __future__ import annotations

def _schema(base: Any) -> dict[str, Any]:
    amount_row = base._oa_obj(
        {
            "currency": base._OA_STRING,
            "rows": base._OA_INT,
            "purchases": base._OA_STRING,
            "sales": base._OA_STRING,
            "broker_commission": base._OA_STRING,
            "exchange_commission": base._OA_STRING,
            "clearing_commission": base._OA_STRING,
            "total_commission": base._OA_STRING,
        }
    )
    reconciliation_row = base._oa_obj(
        {
            "currency": base._OA_STRING,
            "report_purchases": base._OA_STRING,
            "operations_purchases": base._OA_STRING,
            "purchases_difference": base._OA_STRING,
            "report_sales": base._OA_STRING,
            "operations_sales": base._OA_STRING,
            "sales_difference": base._OA_STRING,
            "status": base._OA_STRING,
        }
    )
    commission_row = base._oa_obj(
        {
            "currency": base._OA_STRING,
            "report_broker_commission": base._OA_STRING,
            "operations_broker_commission": base._OA_STRING,
            "broker_commission_difference": base._OA_STRING,
            "report_exchange_commission": base._OA_STRING,
            "report_clearing_commission": base._OA_STRING,
            "exchange_and_clearing_api_comparison": base._OA_STRING,
            "status": base._OA_STRING,
        }
    )
    error_detail = base._oa_obj(
        {
            "code": base._OA_STRING,
            "grpc_code": base._OA_STRING,
            "exception_type": base._OA_STRING,
            "message": base._OA_STRING,
        }
    )
    return base._oa_obj(
        {
            "status": base._OA_STRING,
            "version": base._OA_STRING,
            "retrieved_at": base._OA_STRING,
            "account": base._OA_ACCOUNT,
            "period": base._oa_obj(
                {
                    "from": base._OA_STRING,
                    "to": base._OA_STRING,
                    "requested_days": base._OA_INT,
                    "period_adjusted_to_calendar_year": base._OA_BOOL,
                }
            ),
            "report_generation": base._oa_obj(
                {
                    "status": base._OA_STRING,
                    "task_id": base._OA_STRING,
                    "wait_seconds": base._OA_INT,
                    "error": error_detail,
                }
            ),
            "report_pagination": base._oa_obj(
                {
                    "pages_fetched": base._OA_INT,
                    "pages_count": base._OA_INT,
                    "items_count": base._OA_INT,
                    "rows_received": base._OA_INT,
                    "max_pages": base._OA_INT,
                    "truncated": base._OA_BOOL,
                }
            ),
            "broker_report_summary": base._oa_obj(
                {
                    "rows": base._OA_INT,
                    "unique_trade_ids": base._OA_INT,
                    "direction_counts": base._oa_obj(
                        {
                            "purchases": base._OA_INT,
                            "sales": base._OA_INT,
                            "other": base._OA_INT,
                        }
                    ),
                    "by_currency": base._oa_array(amount_row),
                    "currencies_detected": base._OA_INT,
                    "invalid_money_rows": base._OA_INT,
                }
            ),
            "operations_summary": base._oa_obj(
                {
                    "status": base._OA_STRING,
                    "operations_count": base._OA_INT,
                    "executed_operations": base._OA_INT,
                    "duplicates_removed": base._OA_INT,
                    "pagination": base._oa_obj({}),
                    "reconciliation": base._oa_obj({}),
                }
            ),
            "trade_reconciliation": base._oa_obj(
                {
                    "status": base._OA_STRING,
                    "report_trade_rows": base._OA_INT,
                    "operations_trade_rows": base._OA_INT,
                    "matched": base._OA_INT,
                    "matched_by_trade_id": base._OA_INT,
                    "matched_by_fallback": base._OA_INT,
                    "report_only": base._OA_INT,
                    "operations_only": base._OA_INT,
                    "report_only_examples": base._oa_array(
                        base._oa_obj(
                            {
                                "trade_id": base._OA_STRING,
                                "figi": base._OA_STRING,
                                "direction": base._OA_STRING,
                                "trade_datetime": base._OA_STRING,
                                "quantity": base._OA_STRING,
                            }
                        )
                    ),
                }
            ),
            "cash_flow_reconciliation": base._oa_array(reconciliation_row),
            "commission_reconciliation": base._oa_array(commission_row),
            "reconciliation": base._oa_obj(
                {
                    "trade_status": base._OA_STRING,
                    "cash_flow_status": base._OA_STRING,
                    "commission_status": base._OA_STRING,
                    "confirmed": base._OA_BOOL,
                    "status": base._OA_STRING,
                }
            ),
            "quality": base._oa_obj(
                {
                    "report_ready": base._OA_BOOL,
                    "report_pagination_complete": base._OA_BOOL,
                    "operations_complete": base._OA_BOOL,
                    "report_rows": base._OA_INT,
                    "operations_rows": base._OA_INT,
                    "report_invalid_money_rows": base._OA_INT,
                    "trade_reconciliation_confirmed": base._OA_BOOL,
                    "cash_flow_reconciliation_confirmed": base._OA_BOOL,
                    "commission_reconciliation_confirmed": base._OA_BOOL,
                    "component_errors": base._OA_INT,
                    "complete": base._OA_BOOL,
                    "no_cross_currency_aggregation": base._OA_BOOL,
                    "read_only": base._OA_BOOL,
                }
            ),
            "complete": base._OA_BOOL,
            "component_errors": base._oa_array(
                base._oa_obj(
                    {
                        "component": base._OA_STRING,
                        "error": error_detail,
                    }
                )
            ),
            "trading_methods": base._OA_BOOL,
            "warnings": base._oa_array(base._OA_STRING),
        },
        required=[
            "status",
            "version",
            "retrieved_at",
            "account",
            "period",
            "report_generation",
            "broker_report_summary",
            "trade_reconciliation",
            "commission_reconciliation",
            "cash_flow_reconciliation",
            "quality",
            "complete",
            "trading_methods",
        ],
    )

