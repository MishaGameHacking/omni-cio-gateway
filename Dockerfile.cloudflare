FROM node:24.18.0-bookworm-slim AS web-build
WORKDIR /build
COPY apps/web/package.json apps/web/package-lock.json ./apps/web/
RUN npm ci --prefix apps/web
COPY apps/web ./apps/web
RUN npm run --prefix apps/web build

FROM python:3.12.10-slim-bookworm AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /app

RUN groupadd --system omni && useradd --system --gid omni --home-dir /app omni
COPY requirements.txt ./requirements.txt
RUN python -m pip install --require-hashes -r requirements.txt

COPY apps ./apps
COPY omni_cio ./omni_cio
COPY --from=web-build /build/apps/web/dist ./apps/web/dist

RUN chown -R omni:omni /app
USER omni
EXPOSE 8080

CMD ["python", "-m", "uvicorn", "apps.api.cloudflare_runtime:create_app", "--factory", "--host", "0.0.0.0", "--port", "8080", "--proxy-headers", "--forwarded-allow-ips", "*"]
