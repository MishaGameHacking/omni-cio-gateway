from __future__ import annotations

def summarize_broker_report(
    *,
    base: Any,
    rows: list[dict[str, Any]],
) -> dict[str, Any]:
    by_currency: dict[str, dict[str, Decimal | int]] = defaultdict(
        lambda: {
            "rows": 0,
            "purchases": Decimal("0"),
            "sales": Decimal("0"),
            "broker_commission": Decimal("0"),
            "exchange_commission": Decimal("0"),
            "clearing_commission": Decimal("0"),
        }
    )
    direction_counts = {"purchases": 0, "sales": 0, "other": 0}
    invalid_money_rows = 0
    currencies: set[str] = set()
    trade_ids: set[str] = set()

    for row in rows:
        direction = _report_direction(row.get("direction"))
        direction_counts[direction] += 1
        trade_id = str(row.get("trade_id", "") or "").strip()
        if trade_id:
            trade_ids.add(trade_id)

        amount, currency = _money(base, row.get("total_order_amount"))
        if amount is None:
            amount, currency = _money(base, row.get("order_amount"))
        if not currency:
            for field in (
                "broker_commission",
                "exchange_commission",
                "exchange_clearing_commission",
                "price",
            ):
                _, currency = _money(base, row.get(field))
                if currency:
                    break
        currency = currency or "UNKNOWN"
        currencies.add(currency)
        bucket = by_currency[currency]
        bucket["rows"] = int(bucket["rows"]) + 1
        if amount is None:
            invalid_money_rows += 1
        elif direction in {"purchases", "sales"}:
            bucket[direction] = Decimal(str(bucket[direction])) + abs(amount)

        for field, key in (
            ("broker_commission", "broker_commission"),
            ("exchange_commission", "exchange_commission"),
            ("exchange_clearing_commission", "clearing_commission"),
        ):
            commission, commission_currency = _money(base, row.get(field))
            if commission is None:
                continue
            target_currency = commission_currency or currency
            currencies.add(target_currency)
            target = by_currency[target_currency]
            target[key] = Decimal(str(target[key])) + abs(commission)

    serialized: list[dict[str, Any]] = []
    for currency in sorted(by_currency):
        bucket = by_currency[currency]
        total_commission = (
            Decimal(str(bucket["broker_commission"]))
            + Decimal(str(bucket["exchange_commission"]))
            + Decimal(str(bucket["clearing_commission"]))
        )
        serialized.append(
            {
                "currency": currency,
                "rows": int(bucket["rows"]),
                "purchases": base.decimal_string(
                    Decimal(str(bucket["purchases"]))
                ),
                "sales": base.decimal_string(Decimal(str(bucket["sales"]))),
                "broker_commission": base.decimal_string(
                    Decimal(str(bucket["broker_commission"]))
                ),
                "exchange_commission": base.decimal_string(
                    Decimal(str(bucket["exchange_commission"]))
                ),
                "clearing_commission": base.decimal_string(
                    Decimal(str(bucket["clearing_commission"]))
                ),
                "total_commission": base.decimal_string(total_commission),
            }
        )

    return {
        "rows": len(rows),
        "unique_trade_ids": len(trade_ids),
        "direction_counts": direction_counts,
        "by_currency": serialized,
        "currencies_detected": len(currencies),
        "invalid_money_rows": invalid_money_rows,
    }

def reconcile_trade_rows(
    *,
    base: Any,
    report_rows: list[dict[str, Any]],
    raw_operations: list[dict[str, Any]],
) -> dict[str, Any]:
    api_rows = _operation_trades(base=base, operations=raw_operations)
    api_by_trade_id: dict[str, list[int]] = defaultdict(list)
    api_by_fallback: dict[str, list[int]] = defaultdict(list)
    for index, row in enumerate(api_rows):
        kind, identity = _row_identity(base, row)
        if identity:
            (api_by_trade_id if kind == "trade_id" else api_by_fallback)[
                identity
            ].append(index)

    used: set[int] = set()
    matched_by_trade_id = 0
    matched_by_fallback = 0
    report_only_examples: list[dict[str, Any]] = []

    for row in report_rows:
        kind, identity = _row_identity(base, row)
        candidates = (
            api_by_trade_id.get(identity, [])
            if kind == "trade_id"
            else api_by_fallback.get(identity, [])
        )
        match_index = next((idx for idx in candidates if idx not in used), None)

        if match_index is None and kind == "trade_id":
            _, fallback = _row_identity(
                base,
                {**row, "trade_id": ""},
            )
            candidates = api_by_fallback.get(fallback, [])
            match_index = next((idx for idx in candidates if idx not in used), None)
            if match_index is not None:
                matched_by_fallback += 1
        elif match_index is not None:
            matched_by_trade_id += 1

        if match_index is None:
            if len(report_only_examples) < 20:
                report_only_examples.append(
                    {
                        "trade_id": str(row.get("trade_id", "") or ""),
                        "figi": str(row.get("figi", "") or ""),
                        "direction": _report_direction(row.get("direction")),
                        "trade_datetime": str(
                            row.get("trade_datetime", "") or ""
                        ),
                        "quantity": str(row.get("quantity", "") or ""),
                    }
                )
            continue
        used.add(match_index)

    operations_only = len(api_rows) - len(used)
    report_only = len(report_rows) - len(used)
    status = (
        "matched"
        if report_only == 0 and operations_only == 0
        else "warning"
    )
    return {
        "status": status,
        "report_trade_rows": len(report_rows),
        "operations_trade_rows": len(api_rows),
        "matched": len(used),
        "matched_by_trade_id": matched_by_trade_id,
        "matched_by_fallback": matched_by_fallback,
        "report_only": report_only,
        "operations_only": operations_only,
        "report_only_examples": report_only_examples,
    }

def _rows_by_currency(rows: list[dict[str, Any]]) -> dict[str, dict[str, Any]]:
    return {str(row.get("currency", "")): row for row in rows}

