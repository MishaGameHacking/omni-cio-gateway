from __future__ import annotations

def reconcile_cash_and_commissions(
    *,
    base: Any,
    report_summary: dict[str, Any],
    operations_payload: dict[str, Any],
) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    report_by_currency = _rows_by_currency(report_summary.get("by_currency", []))
    operations_by_currency = _rows_by_currency(
        operations_payload.get("cash_summary_by_currency", [])
    )
    currencies = sorted(set(report_by_currency) | set(operations_by_currency))
    cash_rows: list[dict[str, Any]] = []
    commission_rows: list[dict[str, Any]] = []

    def as_decimal(value: Any) -> Decimal:
        try:
            return Decimal(str(value or "0"))
        except Exception:
            return Decimal("0")

    for currency in currencies:
        report = report_by_currency.get(currency, {})
        operations = operations_by_currency.get(currency, {})
        report_buy = as_decimal(report.get("purchases"))
        report_sell = as_decimal(report.get("sales"))
        api_buy = as_decimal((operations.get("purchases") or {}).get("amount"))
        api_sell = as_decimal((operations.get("sales") or {}).get("amount"))
        buy_difference = report_buy - api_buy
        sell_difference = report_sell - api_sell
        cash_status = (
            "matched"
            if abs(buy_difference) <= MONEY_TOLERANCE
            and abs(sell_difference) <= MONEY_TOLERANCE
            else "warning"
        )
        cash_rows.append(
            {
                "currency": currency,
                "report_purchases": base.decimal_string(report_buy),
                "operations_purchases": base.decimal_string(api_buy),
                "purchases_difference": base.decimal_string(buy_difference),
                "report_sales": base.decimal_string(report_sell),
                "operations_sales": base.decimal_string(api_sell),
                "sales_difference": base.decimal_string(sell_difference),
                "status": cash_status,
            }
        )

        report_broker = as_decimal(report.get("broker_commission"))
        report_exchange = as_decimal(report.get("exchange_commission"))
        report_clearing = as_decimal(report.get("clearing_commission"))
        api_broker = as_decimal(
            (operations.get("broker_commissions") or {}).get("amount")
        )
        broker_difference = report_broker - api_broker
        commission_status = (
            "matched"
            if abs(broker_difference) <= MONEY_TOLERANCE
            else "warning"
        )
        commission_rows.append(
            {
                "currency": currency,
                "report_broker_commission": base.decimal_string(report_broker),
                "operations_broker_commission": base.decimal_string(api_broker),
                "broker_commission_difference": base.decimal_string(
                    broker_difference
                ),
                "report_exchange_commission": base.decimal_string(
                    report_exchange
                ),
                "report_clearing_commission": base.decimal_string(
                    report_clearing
                ),
                "exchange_and_clearing_api_comparison": "not_separately_available",
                "status": commission_status,
            }
        )
    return cash_rows, commission_rows

