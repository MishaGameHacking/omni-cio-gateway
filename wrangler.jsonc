{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "omni-cio-v10-web",
  "main": "./cloudflare/src/index.js",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "keep_vars": true,
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz"]
  },
  "vars": {
    "OMNI_V10_POSTGRES_RUNTIME_ROLE": "omni_cio_cloudflare_prod",
    "PUBLIC_MULTI_USER_ENABLED": "false",
    "OMNI_V10_TELEGRAM_LOGIN_ENABLED": "false",
    "OMNI_V10_VK_ID_LOGIN_ENABLED": "false"
  },
  "secrets": {
    "required": ["OMNI_V10_POSTGRES_DSN"]
  },
  "containers": [
    {
      "class_name": "Backend",
      "image": "./Dockerfile.cloudflare",
      "max_instances": 1,
      "instance_type": "lite",
      "rollout_active_grace_period": 0,
      "rollout_step_percentage": 100
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BACKEND",
        "class_name": "Backend"
      }
    ]
  },
  "migrations": [
    {
      "tag": "cloudflare-container-v1",
      "new_sqlite_classes": ["Backend"]
    }
  ],
  "env": {
    "staging": {
      "name": "omni-cio-v10-web-staging",
      "workers_dev": true,
      "vars": {
        "OMNI_V10_POSTGRES_RUNTIME_ROLE": "omni_cio_cloudflare_staging",
        "PUBLIC_MULTI_USER_ENABLED": "false",
        "OMNI_V10_TELEGRAM_LOGIN_ENABLED": "false",
        "OMNI_V10_VK_ID_LOGIN_ENABLED": "false"
      },
      "secrets": {
        "required": ["OMNI_V10_POSTGRES_DSN"]
      },
      "containers": [
        {
          "class_name": "Backend",
          "image": "./Dockerfile.cloudflare",
          "max_instances": 1,
          "instance_type": "lite",
          "rollout_active_grace_period": 0,
          "rollout_step_percentage": 100
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "BACKEND",
            "class_name": "Backend"
          }
        ]
      },
      "migrations": [
        {
          "tag": "cloudflare-container-v1",
          "new_sqlite_classes": ["Backend"]
        }
      ]
    }
  }
}
