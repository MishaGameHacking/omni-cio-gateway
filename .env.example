# Copy to .env locally and replace placeholders.
# Never commit the real .env file or real secret values.

# Omni-CIO production read-only Gateway
TINVEST_TOKEN=replace_with_tinvest_read_only_token
GATEWAY_API_KEY=replace_with_long_random_gateway_key
SSL_TBANK_VERIFY=True

# Optional T-Invest Sandbox execution contour.
# Keep disabled in production until the sandbox PR is merged and accepted.
# This must be a dedicated Sandbox token, NOT the production TINVEST_TOKEN.
TINVEST_SANDBOX_TOKEN=replace_with_dedicated_sandbox_token
SANDBOX_TRADING_ENABLED=false
SANDBOX_CONFIRMATION_TTL_SECONDS=120

# Render provides this automatically to the web service in production.
# RENDER_EXTERNAL_URL=https://your-render-service.example
