# Copy to .env locally and replace placeholders.
# Never commit the real .env file or real secret values.

# Omni-CIO Gateway
TINVEST_TOKEN=replace_with_tinvest_read_only_token
GATEWAY_API_KEY=replace_with_long_random_gateway_key
SSL_TBANK_VERIFY=True

# Telegram Companion
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
TELEGRAM_WEBHOOK_SECRET=replace_with_random_webhook_secret
TELEGRAM_ALLOWED_USER_IDS=123456789
OMNI_GATEWAY_URL=https://omni-cio-gateway-au6d.onrender.com
OMNI_GATEWAY_API_KEY=replace_with_same_gateway_key
TELEGRAM_AUTO_CONFIGURE=True
TELEGRAM_REQUEST_TIMEOUT_SECONDS=20
TELEGRAM_GATEWAY_RETRY_ATTEMPTS=2
TELEGRAM_GATEWAY_RETRY_DELAY_SECONDS=5
TELEGRAM_MAX_RESPONSE_CHARS=12000
TELEGRAM_MIN_REQUEST_INTERVAL_SECONDS=1.5

# Render provides this automatically to each web service in production.
# RENDER_EXTERNAL_URL=https://your-render-service.example
