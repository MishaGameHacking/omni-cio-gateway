[Unit]
Description=Analyst AI public APK update channel
After=network.target

[Service]
Type=exec
DynamicUser=yes
User=analyst-updates
WorkingDirectory=/opt/analyst-ai-updates
Environment=ANDROID_RELEASE_DIR=/srv/analyst-ai-ota/releases
Environment=ANDROID_UPDATES_ENABLED=false
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/analyst-ai-updates/venv/bin/python -B -m uvicorn backend.public_updates_app:create_app --factory --host 127.0.0.1 --port 8081 --workers 1 --no-access-log
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077
MemoryHigh=201326592
MemoryMax=268435456
CPUWeight=30
TasksMax=64

[Install]
WantedBy=multi-user.target
