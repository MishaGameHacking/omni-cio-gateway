#!/usr/bin/env python3
import json,os,pathlib,subprocess,sys
command=sys.argv[1] if len(sys.argv)==2 else "status"
if command=="status":
    subprocess.run(["runuser","-u","analyst-build","--","/var/lib/analyst-ai-build/venv/bin/python","/srv/analyst-ai/workspace/deploy/timeweb_workspace.py","status"],check=True)
elif command in ("check","build","runtime"):
    if os.geteuid()!=0:raise SystemExit("Run this administrative command as root")
    states=subprocess.check_output(["systemctl","list-units","analyst-workspace@*.service","--state=activating","--no-legend"],text=True).strip()
    if states:raise SystemExit("A workspace stage is already running")
    subprocess.run(["systemctl","restart","--no-block","analyst-workspace@"+command+".service"],check=True)
    print("Started "+command+" on this Timeweb server. Run analyst-workspace status for the measured result.")
elif command=="publish":
    if os.geteuid()!=0:raise SystemExit("Run this administrative command as root")
    subprocess.run(["/opt/analyst-ai/venv/bin/python","/srv/analyst-ai/workspace/deploy/publish_timeweb_workspace.py"],check=True)
else:raise SystemExit("Usage: analyst-workspace {status|check|build|runtime|publish}")
