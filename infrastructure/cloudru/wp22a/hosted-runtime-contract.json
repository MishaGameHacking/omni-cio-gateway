{
  "schema_version": "v10.wp22a.phase3.hosted-runtime.v1",
  "authority": {
    "provider": "Cloud.ru Evolution",
    "source_only": true,
    "provider_apply_authorized": false,
    "public_ingress_enabled": false,
    "authorized_recurring_rub": 0,
    "public_multi_user_enabled": false,
    "trading_methods_enabled": false,
    "real_trading_enabled": false,
    "protected_v9_entrypoint": "app:app",
    "wp23_unlocked": false
  },
  "runtime_roles": {
    "web": {
      "private_state_access": false,
      "broker_secret_access": false
    },
    "api": {
      "private_state_access": true,
      "broker_secret_access": "tenant_scoped_read_only_decrypt"
    },
    "migration": {
      "private_state_access": true,
      "broker_secret_access": false
    },
    "backup": {
      "private_state_access": "snapshot_only",
      "broker_secret_access": "ciphertext_only"
    }
  },
  "private_state": {
    "database": "postgresql",
    "tenant_context_required": true,
    "rls_required": true,
    "least_privilege_runtime_role_required": true,
    "public_database_ingress_allowed": false
  },
  "broker_secret_custody": {
    "scope": "tenant",
    "credential_role": "read",
    "plaintext_at_rest_allowed": false,
    "plaintext_in_github_ci_artifacts_allowed": false,
    "browser_readback_allowed": false,
    "provider_backed_encryption_required": true,
    "runtime_decrypt_role": "api",
    "cross_tenant_access_allowed": false
  },
  "recovery": {
    "encrypted_backup_required": true,
    "off_runtime_copy_required": true,
    "sha256_integrity_required": true,
    "corrupt_backup_rejection_required": true,
    "tenant_isolation_after_restore_required": true,
    "replacement_runtime_recovery_required": true,
    "rollback_to_last_accepted_release_required": true
  }
}
