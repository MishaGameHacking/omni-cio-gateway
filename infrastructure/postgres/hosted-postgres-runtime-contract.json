{
  "schema_version": "v10.hosted-postgres-runtime.v5",
  "authority": {
    "provider": "PROVIDER_NEUTRAL_POSTGRESQL_18",
    "source_only": true,
    "provider_apply_authorized": false,
    "public_database_ingress_allowed": false,
    "authorized_recurring_rub": 0,
    "public_multi_user_enabled": false,
    "trading_methods_enabled": false,
    "real_trading_enabled": false,
    "protected_v9_entrypoint": "app:app",
    "wp23_unlocked": false
  },
  "provider_user": {
    "name": "omni_cio_hosted_api",
    "resource_type": "postgresql_runtime_login",
    "provisioning_phase": "PROVIDER_ADAPTER",
    "source_bootstrap_creates_user": false,
    "login_required": true,
    "credential_delivery": "external_non_source",
    "credential_value_in_source_allowed": false,
    "predefined_roles": [],
    "database_owner": false,
    "schema_owner": false,
    "object_owner": false,
    "superuser": false,
    "create_database": false,
    "create_role": false,
    "replication": false,
    "bypass_rls": false
  },
  "bootstrap": {
    "provider_user_must_preexist": true,
    "run_after_migrations": true,
    "reapply_after_every_migration": true,
    "public_schema_create_revoked": true,
    "public_app_schema_privileges_revoked": true,
    "public_function_execute_revoked": true,
    "public_database_temporary_revoked": true
  },
  "schema": {
    "name": "omni_cio_v10",
    "usage": true,
    "create": false
  },
  "database_privileges": [
    "CONNECT"
  ],
  "function_privileges": {
    "current_tenant_scope()": [
      "EXECUTE"
    ]
  },
  "relation_privileges": {
    "tenants": [
      "INSERT"
    ],
    "users": [
      "SELECT",
      "INSERT"
    ],
    "external_identity_bindings": [
      "SELECT",
      "INSERT"
    ],
    "web_sessions": [
      "SELECT",
      "INSERT",
      "UPDATE",
      "DELETE"
    ],
    "provider_auth_transactions": [
      "SELECT",
      "INSERT",
      "DELETE"
    ],
    "broker_accounts": [
      "SELECT",
      "INSERT"
    ],
    "broker_connections": [
      "SELECT",
      "INSERT",
      "UPDATE"
    ],
    "broker_connection_accounts": [
      "SELECT",
      "INSERT"
    ]
  },
  "rls": {
    "tenant_setting": "omni_cio.tenant_id",
    "transaction_local_required": true,
    "unscoped_default_deny": true,
    "forced_relations": [
      "broker_accounts",
      "broker_connections",
      "broker_connection_accounts"
    ]
  },
  "forbidden_relations": [
    "schema_migrations",
    "portfolios",
    "instruments",
    "policies",
    "portfolio_snapshots",
    "positions",
    "evidence",
    "incidents",
    "incident_revisions",
    "incident_evidence",
    "decisions",
    "decision_evidence",
    "plans",
    "executions",
    "journal",
    "research_cache",
    "jobs",
    "job_events",
    "system_health",
    "content_blobs",
    "state_revisions"
  ],
  "forbidden_predefined_roles": [
    "pg_read_all_data",
    "pg_write_all_data"
  ]
}
