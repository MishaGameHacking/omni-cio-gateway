{
  "schema_version": "1",
  "policy": "WP5_CONSERVATIVE_NODE_GUARDRAILS",
  "clock": {
    "warn_absolute_offset_ms": 500,
    "block_sensitive_absolute_offset_ms": 2000,
    "unknown_offset_blocks_sensitive_operations": true,
    "windows_time_service_must_be_running": true,
    "canonical_application_timezone": "UTC"
  },
  "storage": {
    "warn_free_percent": 20,
    "block_free_percent": 10,
    "warn_free_gib": 50,
    "block_free_gib": 20,
    "physical_disk_health_required": "Healthy"
  },
  "memory": {
    "warn_used_percent": 85,
    "block_new_heavy_work_percent": 95
  },
  "thermal": {
    "gpu_warn_c": 80,
    "gpu_abort_load_test_c": 87,
    "acpi_zone_warn_c": 85,
    "acpi_zone_abort_load_test_c": 95,
    "manufacturer_limit_takes_precedence_when_lower": true
  },
  "load_test": {
    "minimum_duration_minutes": 30,
    "target_duration_minutes": 45,
    "maximum_duration_minutes": 60,
    "sample_interval_seconds": 5,
    "thermal_abort_required": true
  },
  "network": {
    "wired_connection_required_for_24x7_node": true,
    "windows_firewall_profiles_required_enabled": ["Domain", "Private", "Public"],
    "default_inbound_policy_target": "Block",
    "public_v10_listener_allowed": false
  },
  "encryption": {
    "system_volume_full_disk_encryption_required": true,
    "recovery_key_must_be_stored_separately_from_node": true,
    "recovery_key_value_must_never_enter_repository_or_ci": true
  }
}
