{
  "schema": "omni-cio.v10.cloudflare-runtime-compatibility.v1",
  "status": "BRANCH_LOCAL_CF_B_IMPLEMENTATION",
  "update_id": "CLOUDFLARE-PUBLIC-PRODUCT-INTEGRATED",
  "milestone": "CF-B",
  "decision_date": "2026-08-29",
  "accepted_base_sha": "2106f1b1792bc710c8eaa68d6be87e04455c0263",
  "frontend": {
    "source": "apps/web",
    "framework": "React/Vite",
    "placement": "WORKERS_STATIC_ASSETS",
    "spa_fallback": true,
    "worker_first_paths": ["/api/*", "/healthz"],
    "source_sha_precedence": ["WORKERS_CI_COMMIT_SHA", "GITHUB_SHA", "RENDER_GIT_COMMIT"]
  },
  "backend": {
    "source": "apps/api",
    "framework": "FastAPI",
    "python": "3.14.6",
    "placement": "CLOUDFLARE_CONTAINER",
    "reason": [
      "t-tech-investments imports native grpc runtime",
      "psycopg[binary] is a native PostgreSQL driver",
      "accepted backend must not be rewritten merely to fit Python Workers package constraints"
    ],
    "instance_type": "lite",
    "max_instances": 1,
    "sleep_after": "1m",
    "non_root": true,
    "internal_hostname": "omni-cio.internal"
  },
  "database": {
    "engine": "PostgreSQL",
    "major": 18,
    "provider": "Neon",
    "connection": "DIRECT_TLS_DSN_FROM_CLOUDFLARE_SECRET",
    "hyperdrive_used": false,
    "d1_used": false,
    "reason": "Cloudflare currently documents Hyperdrive known PostgreSQL support through 17.x; PG18 compatibility is not assumed."
  },
  "security": {
    "incoming_forwarded_headers_are_stripped_at_worker": true,
    "worker_sets_internal_forwarded_proto_https": true,
    "container_is_not_direct_public_ingress": true,
    "container_transport_uses_fixed_internal_url": true,
    "container_transport_url": "https://omni-cio.internal/_omni/cloudflare-proxy",
    "public_route_is_encoded_in_internal_headers": true,
    "public_route_is_validated_before_asgi_restore": true,
    "internal_route_headers_are_removed_before_app": true,
    "runtime_database_secret_required": true,
    "database_secret_absence_returns_503_before_container_start": true,
    "telegram_vk_provider_auth_enabled": false,
    "public_multi_user_enabled": false,
    "broker_write": false,
    "trading_methods": false,
    "real_trading_enabled": false
  },
  "cost": {
    "workers_paid_required": true,
    "container_included_usage_preferred": true,
    "smallest_instance_selected": true,
    "scale_to_zero": true,
    "automatic_paid_overage_authorized": false,
    "note": "Cloudflare budget alerts are informational rather than hard spend caps; production usage must remain inside accepted capacity or later obtain fresh OWNER authority."
  },
  "release": {
    "worker_name": "omni-cio-v10-web",
    "workers_dev_enabled": true,
    "exact_source_sha_generated_before_build": true,
    "release_endpoint": "/api/v10/release",
    "container_rollout": "immediate",
    "dashboard_vars_preserved": true
  },
  "exit_gate": {
    "python_worker_rewrite_required": false,
    "hyperdrive_pg18_assumed": false,
    "static_assets_configured": true,
    "container_backend_configured": true,
    "direct_postgres18_preserved": true,
    "provider_mutation_performed": false
  }
}
