{
  "schema_version": "1",
  "contract": "V10_WP6_IDENTITY_PRIVILEGE_CONTRACT",
  "roles": {
    "owner_admin": {
      "interactive": true,
      "administrator": true,
      "ci_identity": false
    },
    "ci_runner": {
      "administrator": false,
      "must_be_distinct_from_owner": true,
      "must_be_distinct_from_runtime": true,
      "must_be_distinct_from_execution": true,
      "execution_secret_access": "DENY",
      "allowed_service_account_classes": [
        "NETWORK_SERVICE",
        "LOCAL_SERVICE",
        "VIRTUAL_SERVICE",
        "LOCAL_OR_DOMAIN_USER"
      ]
    },
    "runtime": {
      "role_name": "omni-cio-runtime",
      "administrator": false,
      "identity_anchor_may_be_disabled_until_service_bootstrap": true,
      "execution_secret_access": "DENY",
      "runner_configuration_write_access": "DENY",
      "runner_root_access": "DENY",
      "broker_write_authority": "DENY"
    },
    "execution": {
      "role_name": "omni-cio-execution",
      "administrator": false,
      "identity_anchor_may_be_disabled_until_service_bootstrap": true,
      "execution_secret_access": "READ_WHEN_PROVISIONED",
      "runner_root_access": "DENY",
      "transfer_withdraw_margin_short_authority": "DENY"
    }
  },
  "local_paths": {
    "secret_root": "C:\\ProgramData\\OmniCIO\\secrets",
    "execution_secret_root": "C:\\ProgramData\\OmniCIO\\secrets\\execution",
    "execution_acl_sentinel": "C:\\ProgramData\\OmniCIO\\secrets\\execution\\wp6-ci-deny-sentinel.txt",
    "runner_root": "C:\\actions-runner"
  },
  "forbidden_ci_secret_names": [
    "TINVEST_TRADING_TOKEN",
    "TINVEST_TRANSFER_TOKEN",
    "TELEGRAM_BOT_TOKEN",
    "TELEGRAM_TOKEN",
    "PRIVATE_DB_DUMP",
    "OMNI_PRIVATE_DB_DUMP"
  ],
  "workflow_rules": {
    "github_permissions": "contents: read",
    "persist_checkout_credentials": false,
    "real_secret_context_allowed": false,
    "raw_windows_identity_logging_allowed": false
  },
  "deployment": {
    "authority": "REVIEWED_RELEASE_IDENTITY",
    "required_identity_source": "V10_RELEASE_MANIFEST",
    "arbitrary_pr_worktree_in_secret_context": false
  },
  "negative_tests": {
    "runner_cannot_read_execution_secret": true,
    "runtime_cannot_read_execution_secret": true,
    "runtime_cannot_modify_runner_configuration": true,
    "runtime_cannot_modify_runner_root": true,
    "execution_cannot_modify_runner_root": true,
    "ai_or_general_runtime_cannot_use_broker_write_secret_or_tool": true
  },
  "privacy": {
    "raw_usernames_allowed_in_evidence": false,
    "sids_allowed_in_evidence": false,
    "hostnames_allowed_in_evidence": false,
    "addresses_allowed_in_evidence": false,
    "secret_values_allowed_in_evidence": false,
    "process_lists_allowed_in_evidence": false
  }
}
