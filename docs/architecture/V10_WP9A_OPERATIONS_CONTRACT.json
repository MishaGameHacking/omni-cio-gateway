{
  "schema_version": "1",
  "work_package": "WP9A",
  "title": "Runtime patching, time, observability and controlled restart policy",
  "accepted_base_reference": "STATUS_PR_260",
  "authority": {
    "master_plan": "docs/master-plan/OMNI_CIO_V10_MASTER_PLAN.md",
    "wp5_thresholds": "infrastructure/windows/wp5_node_thresholds.json",
    "wp9_supervision": "docs/architecture/V10_WP9_SUPERVISION_CONTRACT.json",
    "stable_entrypoint": "app:app",
    "trading_methods": false,
    "real_money_authority_change": false
  },
  "maintenance": {
    "mode": "OWNER_REVIEWED_WINDOW",
    "window_local": {
      "start": "03:00",
      "end": "05:00"
    },
    "pre_update_health_required": true,
    "post_update_health_required": true,
    "post_reboot_wp9_audit_required": true,
    "pending_reboot_blocks_new_heavy_work": true,
    "silent_product_behavior_change_forbidden": true
  },
  "windows_update": {
    "policy": "OS_MANAGED_SECURITY_UPDATES_WITH_CONTROLLED_REBOOT",
    "service_must_not_be_disabled": true,
    "automatic_restart_inside_owner_active_window_forbidden": true,
    "quality_update_completion_target_days": 7,
    "feature_update_requires_review": true,
    "direct_registry_mutation_by_wp9a": false
  },
  "github_runner": {
    "policy": "DEFAULT_AUTO_UPDATE_MONITORED",
    "service_health_required": true,
    "update_log_health_required": true,
    "manual_disable_update_forbidden_without_review": true,
    "staleness_limit_days_when_auto_update_disabled": 30
  },
  "nvidia_driver": {
    "policy": "MANUAL_REVIEWED_UPDATE",
    "automatic_driver_update_by_omni_cio": false,
    "signed_vendor_artifact_required": true,
    "post_update_wp5_thermal_compatibility_required": true,
    "rollback_required": true
  },
  "postgresql": {
    "accepted_major": 18,
    "accepted_minor_floor": "18.4",
    "policy": "MONITOR_AND_REVIEW_MINOR_SECURITY_UPDATES",
    "automatic_update_by_omni_cio": false,
    "major_upgrade_out_of_scope": true,
    "minor_update_requires_regression_and_rollback": true
  },
  "ollama": {
    "policy": "POLICY_ONLY_UNTIL_OWNING_AI_WP",
    "runtime_required_now": false,
    "not_installed_is_acceptable": true,
    "automatic_update_by_omni_cio": false,
    "model_update_requires_eval_and_rollback": true,
    "installation_or_activation_in_wp9a_forbidden": true
  },
  "time": {
    "source_contract": "WP5_CONSERVATIVE_NODE_GUARDRAILS",
    "warning_absolute_offset_ms": 500,
    "block_sensitive_absolute_offset_ms": 2000,
    "unknown_offset_blocks_sensitive_operations": true,
    "windows_time_service_must_be_running": true,
    "canonical_application_timezone": "UTC"
  },
  "resources": {
    "source_contract": "infrastructure/windows/wp5_node_thresholds.json",
    "reuse_wp5_thresholds_without_relaxation": true,
    "heavy_work_blocked_on_wp5_block_state": true,
    "manufacturer_lower_limit_takes_precedence": true
  },
  "restart_and_crash_loop": {
    "source_contract": "WP9",
    "max_attempts": 3,
    "backoff_seconds": 60,
    "infinite_restart_forbidden": true,
    "crash_loop_requires_owner_alert": true,
    "real_execution_auto_restart_without_reconciliation_forbidden": true
  },
  "owner_alert": {
    "critical_reason_code_required": true,
    "current_surfaces": [
      "WP9_HEALTH_EVIDENCE",
      "WP9A_LOCAL_OPERATIONS_JOURNAL"
    ],
    "external_delivery": "NOT_READY_UNTIL_OWNING_INTERACTION_WP",
    "silent_critical_failure_forbidden": true,
    "private_payload_in_alert_forbidden": true
  },
  "logging": {
    "format": "JSONL",
    "file_name": "wp9a-operations.jsonl",
    "local_only_by_default": true,
    "max_file_mib": 10,
    "retained_files": 7,
    "retention_days": 30,
    "integrity": "SHA256_HASH_CHAIN",
    "integrity_fields": [
      "previous_hash",
      "event_hash"
    ],
    "allowed_fields": [
      "schema_version",
      "event_type",
      "severity",
      "component_class",
      "state",
      "reason_code",
      "observed_at_utc",
      "duration_ms",
      "version_class",
      "resource_band",
      "correlation_id"
    ],
    "forbidden_fields": [
      "secret",
      "token",
      "authorization",
      "ciphertext",
      "password",
      "account_id",
      "portfolio_payload",
      "raw_username",
      "hostname",
      "ip_address",
      "mac_address",
      "process_command_line",
      "process_dump"
    ],
    "crash_dump_policy": "NO_AUTOMATIC_PRIVATE_PROCESS_DUMPS",
    "ci_private_payload_upload_forbidden": true,
    "audit_log_tamper_evidence_required_when_durable_journal_exists": true
  },
  "update_impact_gate": {
    "calculations": ["STAGING", "REGRESSION", "ROLLBACK"],
    "ai_behavior": ["STAGING", "EVAL", "ROLLBACK"],
    "database_compatibility": ["STAGING", "REGRESSION", "ROLLBACK"],
    "broker_execution_path": ["STAGING", "REGRESSION", "SECURITY", "OWNER_REVIEW", "ROLLBACK"],
    "update_availability_is_never_real_submit_authority": true
  },
  "privacy": {
    "real_secrets_required": false,
    "private_portfolio_data_required": false,
    "full_account_ids_required": false,
    "raw_process_inventory_required": false
  },
  "exit_gate": {
    "contract_check_pass": true,
    "hosted_windows_compatibility_pass": true,
    "lenovo_operations_audit_pass": true,
    "time_guard_pass": true,
    "resource_guard_pass": true,
    "runner_update_health_pass": true,
    "windows_update_health_pass": true,
    "logging_privacy_pass": true,
    "restart_policy_inherited_pass": true,
    "post_merge_regression_shield_required": true,
    "next_wp": "WP10"
  }
}
