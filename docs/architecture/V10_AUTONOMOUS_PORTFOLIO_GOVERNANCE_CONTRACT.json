{
  "schema_version": "1.0.0",
  "status": "owner-approved-planning-baseline",
  "product": "Omni-CIO V10",
  "mission": "continuous evidence-backed portfolio governance for a Personal Node on the Russian investment market",
  "authority": {
    "financial_truth": "deterministic_core",
    "autonomous_runtime_owner": "guardian_watchtower_decision_pipeline",
    "cortex_role": "bounded_research_interpretation_explanation_and_user_negotiation",
    "real_execution_authority": "isolated_execution_service_after_exact_owner_approval"
  },
  "system_autonomy": {
    "runs_24_7": true,
    "event_driven": true,
    "llm_endless_think_loop_allowed": false,
    "autonomous_jobs": [
      "portfolio_refresh",
      "data_freshness",
      "asset_health_refresh",
      "risk_concentration_liquidity_checks",
      "sanctions_custody_refresh",
      "materiality_prioritization",
      "candidate_universe_screening",
      "watchtower_incident_lifecycle",
      "proposal_recompute_on_material_trigger",
      "post_decision_monitoring",
      "post_trade_reconciliation"
    ],
    "cortex_invocation_reasons": [
      "public_disclosure_interpretation",
      "missing_public_evidence",
      "conflicting_evidence",
      "owner_explanation",
      "owner_clarification",
      "proposal_revision_dialogue",
      "natural_language_intent_normalization"
    ]
  },
  "asset_health": {
    "states": [
      "HEALTHY",
      "WATCH",
      "DETERIORATING",
      "REVIEW_REQUIRED",
      "REPLACEMENT_CANDIDATE",
      "CRITICAL",
      "INSUFFICIENT_DATA"
    ],
    "dimensions": [
      "identity",
      "portfolio_role",
      "credit_quality",
      "profitability",
      "cash_flow",
      "debt",
      "valuation_status",
      "liquidity",
      "market_risk",
      "rate_duration_risk",
      "commodity_exposure",
      "economic_currency_exposure",
      "concentration_contribution",
      "corporate_events",
      "sanctions_state",
      "custody_settlement_risk",
      "data_freshness",
      "evidence_conflicts",
      "health_trend"
    ],
    "monitoring_priority_increases_with_risk_or_uncertainty": true
  },
  "decision_pipeline": {
    "states": [
      "NORMAL",
      "ANOMALY_DETECTED",
      "INVESTIGATING",
      "EVIDENCE_READY",
      "PORTFOLIO_IMPACT_CALCULATED",
      "CANDIDATES_SCREENED",
      "PORTFOLIO_OPTIMIZED",
      "PROPOSAL_READY",
      "OWNER_REVIEW",
      "APPROVED",
      "REJECTED",
      "REVISION_REQUESTED",
      "EXPIRED",
      "BLOCKED_BY_FRESHNESS_OR_POLICY"
    ],
    "default_user_output": "one_ranked_primary_proposal_or_NO_CHANGE",
    "unordered_idea_catalog_as_default": false,
    "proposal_must_be_immutable_before_approval": true,
    "fresh_preflight_before_real_submit": true
  },
  "optimizer": {
    "supports_no_change": true,
    "supports_one_to_one_replacement": true,
    "supports_one_to_many_split": true,
    "supports_multi_position_rebalance": true,
    "portfolio_position_count_hardcoded_small_limit": false,
    "constraint_dimensions": [
      "issuer",
      "sector",
      "asset_class",
      "credit_quality",
      "duration_rate_sensitivity",
      "economic_currency_exposure",
      "liquidity",
      "income_profile",
      "commodity_factor",
      "correlation_diversification",
      "sanctions_custody_risk",
      "owner_preferences",
      "own_cash",
      "lot_and_trading_rules",
      "fees_spread_turnover_costs_when_reliable"
    ],
    "anti_churn_material_improvement_required": true
  },
  "preference_model": {
    "soft_preferences_can_be_revised": true,
    "soft_examples": [
      "income_emphasis",
      "sector_preferences",
      "duration_range",
      "economic_currency_exposure",
      "risk_target_within_hard_limits",
      "holding_count_preference",
      "liquidity_preference"
    ],
    "hard_policy_not_overridable_by_chat": [
      "NO_MARGIN",
      "NO_LEVERAGE",
      "NO_UNCOVERED_SHORT",
      "NO_TRANSFER_WITHDRAWAL",
      "INSUFFICIENT_OWN_CASH",
      "UNSUPPORTED_INSTRUMENT",
      "SANCTIONS_BLOCKED",
      "BROKEN_IDENTITY_OR_DATA_INTEGRITY",
      "STALE_CRITICAL_DATA",
      "INVALID_OR_EXPIRED_APPROVAL",
      "AMBIGUOUS_BROKER_SUBMIT_REQUIRES_RECONCILIATION"
    ]
  },
  "real_execution": {
    "allowed_directions": ["BUY", "SELL"],
    "owner_confirmation_required": true,
    "margin_allowed": false,
    "leverage_allowed": false,
    "uncovered_short_allowed": false,
    "transfer_or_withdrawal_allowed": false,
    "buy_requires_own_available_cash": true,
    "sell_requires_owned_free_quantity": true,
    "cortex_sees_raw_trade_token": false,
    "idempotent_possible_submit_required": true,
    "ambiguous_submit_auto_retry_allowed": false,
    "submitted_equals_filled": false
  },
  "user_communication": {
    "telegram_and_web_share_same_core_and_cortex": true,
    "owner_can_be_contacted_when_site_closed": true,
    "notifications_prioritize_material_events": true,
    "internal_system_cortex_hidden_reasoning_exposed_to_user": false,
    "structured_tool_and_evidence_audit_required": true
  },
  "success_oracle": [
    "all_held_assets_have_health_and_freshness_state",
    "material_events_create_durable_incidents",
    "insufficient_evidence_is_explicit",
    "allowed_universe_is_policy_screened",
    "sanctions_and_custody_gates_apply_before_candidates",
    "deterministic_engine_produces_primary_proposal_or_NO_CHANGE",
    "cortex_explains_but_does_not_become_authority",
    "owner_can_approve_reject_or_revise",
    "only_exact_approved_plan_reaches_execution",
    "post_trade_and_post_decision_monitoring_is_reconciled"
  ]
}
