{
  "schema_version": "1.0.0",
  "program": "Omni-CIO V10",
  "component": "Omni-CIO Cortex",
  "status": "owner-approved-planning-baseline",
  "architecture": {
    "financial_truth_owner": "deterministic_core",
    "ai_role": [
      "interpret",
      "explain",
      "research",
      "orchestrate_allowlisted_tools",
      "monitor",
      "generate_non_authoritative_scenarios_and_drafts"
    ],
    "ai_forbidden_roles": [
      "financial_ledger",
      "portfolio_source_of_truth",
      "broker_write_authority",
      "security_policy_bypass",
      "unrestricted_admin_shell"
    ]
  },
  "default_model": {
    "family": "Qwen3.5",
    "model": "Qwen3.5-4B",
    "license": "Apache-2.0",
    "runtime": "Ollama",
    "quantization_target": "Q4_K_M_or_validated_equivalent",
    "initial_context_tokens": 8192,
    "extended_context_tokens_after_benchmark": 16384,
    "paid_ai_api_required": false,
    "image_ocr_portfolio_import": false
  },
  "agent_runtime": {
    "candidate": "LangGraph OSS",
    "required_capabilities": [
      "durable_execution",
      "checkpointing",
      "restart_resume",
      "human_in_the_loop",
      "bounded_long_running_research"
    ]
  },
  "research": {
    "search_provider_default": "self-hosted SearXNG",
    "browser_fallback": "Playwright",
    "source_priority": [
      "broker_report",
      "moex",
      "cbr_or_regulator",
      "issuer_official",
      "other_primary_source",
      "reputable_secondary_media",
      "general_web"
    ],
    "evidence_required_fields": [
      "source_identity",
      "source_class",
      "retrieved_at",
      "published_at_if_available",
      "instrument_or_issuer_binding",
      "fact_or_claim",
      "freshness_state"
    ]
  },
  "portfolio_truth": {
    "v10_accounting_primary": "verified_broker_html_report",
    "photo_or_ocr_import_allowed": false,
    "market_enrichment": "MOEX_current_quotes",
    "must_separate": [
      "broker_period_end_state",
      "current_market_estimate"
    ],
    "v9_runtime_migration_rule": "preserve_current_v9_behavior_until_responsible_v10_core_data_exit_gate"
  },
  "tool_authority": {
    "auto": [
      "read_portfolio_and_analytics",
      "read_reconciliation_and_system_health",
      "read_local_knowledge",
      "retrieve_public_official_data",
      "bounded_web_search_and_fetch",
      "write_research_cache_evidence_and_checkpoints",
      "create_non_money_alerts_and_drafts"
    ],
    "human_or_engineering_approval": [
      "destructive_private_data_deletion",
      "security_or_firewall_change",
      "windows_administrator_action",
      "secret_change",
      "github_protection_change",
      "production_authority_boundary_change",
      "merge_to_main",
      "real_money_approval_or_submit"
    ],
    "never_direct_to_ai": [
      "raw_broker_trading_token",
      "arbitrary_broker_execute_tool",
      "transfer_or_withdrawal_authority",
      "unrestricted_admin_shell",
      "ci_or_owner_approval_bypass"
    ]
  },
  "autonomy": {
    "mode": "event_driven",
    "endless_think_loop_forbidden": true,
    "approved_trigger_classes": [
      "user_question",
      "new_accepted_broker_report",
      "report_discrepancy",
      "stale_market_or_source_data",
      "deterministic_watchtower_event",
      "connector_failure",
      "scheduled_research_refresh",
      "system_health_degradation",
      "evidence_gap"
    ]
  },
  "specialization_sequence": [
    "system_policy",
    "typed_tool_registry",
    "knowledge_rag",
    "sanitized_eval_corpus",
    "measured_local_benchmark",
    "qlora_only_if_evidence_shows_persistent_gap"
  ],
  "critical_eval_invariants": {
    "broker_write_authority_leakage_allowed": 0,
    "invented_exact_financial_facts_allowed_in_critical_fixtures": 0,
    "critical_tool_schema_validation_required": true,
    "prompt_injection_external_text_must_remain_data": true,
    "ai_unavailable_deterministic_core_must_operate": true
  },
  "cost_policy": {
    "github_pro": "already_accepted_subscription",
    "required_paid_ai_inference_subscription": false,
    "required_paid_search_subscription": false,
    "required_hosted_agent_subscription": false
  },
  "owner_local_action_policy": {
    "default": "engineering_agent_handles_github_code_ci_first",
    "when_local_windows_action_is_unavoidable": "owner_runs_reviewed_idempotent_powershell_block",
    "administrator_only_when_required": true,
    "permanent_ai_process_runs_as_administrator": false
  }
}
