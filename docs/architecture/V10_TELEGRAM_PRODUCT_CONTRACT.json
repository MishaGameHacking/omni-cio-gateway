{
  "contract": "V10_TELEGRAM_PRODUCT_CONTRACT",
  "version": "1.1.0",
  "status": "OWNER_APPROVED_PLANNING_ONLY",
  "runtime_effect": "NONE_UNTIL_OWNING_WP",
  "owned_by": [
    "WP23",
    "WP24",
    "WP25",
    "WP26",
    "WP32C"
  ],
  "product_role": "optional USER companion interface to the same V10 Core, Web and Cortex, linked only after Omni-CIO account authentication",
  "principles": {
    "one_core": true,
    "one_cortex": true,
    "telegram_business_logic": false,
    "telegram_broker_write": false,
    "telegram_is_full_web_duplicate": false,
    "private_owner_only": false,
    "no_required_paid_bot_saas": true,
    "bot_required_for_web_login": false,
    "bot_can_create_account": false,
    "bot_can_mint_or_select_tenant": false
  },
  "access": {
    "allowed_chat_types": [
      "private"
    ],
    "allowed_identity": "existing_authenticated_omni_cio_user_with_explicit_server_side_bot_link",
    "groups": "DENY",
    "supergroups": "DENY",
    "channels": "DENY",
    "inline_mode": "OUT_OF_SCOPE",
    "public_onboarding": "FORBIDDEN_VIA_BOT",
    "unauthorized_response": "TG_AUTH_DENIED_V1_NO_PRIVATE_DATA"
  },
  "transport": {
    "initial": "LONG_POLLING_GET_UPDATES",
    "webhook_initially_required": false,
    "simultaneous_polling_and_webhook": false,
    "persist_update_cursor": true,
    "side_effects_idempotent": true,
    "allowed_updates": "NARROWEST_REQUIRED_AT_WP23",
    "retry_policy": "BOUNDED_BACKOFF_RESPECT_TELEGRAM_RETRY_AFTER"
  },
  "commands": [
    {
      "name": "start",
      "purpose": "owner entry and concise introduction",
      "broker_write": false
    },
    {
      "name": "help",
      "purpose": "capabilities and safety boundaries",
      "broker_write": false
    },
    {
      "name": "status",
      "purpose": "compact V10/data status",
      "broker_write": false
    },
    {
      "name": "portfolio",
      "purpose": "canonical portfolio summary",
      "broker_write": false
    },
    {
      "name": "alerts",
      "purpose": "active material incidents",
      "broker_write": false
    },
    {
      "name": "system",
      "purpose": "owner operational status",
      "broker_write": false
    },
    {
      "name": "app",
      "purpose": "open canonical Web/Mini App",
      "broker_write": false
    }
  ],
  "navigation": {
    "preferred_menu_button": "OPEN_CANONICAL_V10_WEB_MINI_APP_WHEN_SAFE",
    "default_message_controls": "INLINE_KEYBOARDS",
    "persistent_reply_keyboard_required": false,
    "complex_results": "COMPACT_SUMMARY_PLUS_WEB_HANDOFF"
  },
  "canonical_data": {
    "source": "V10_CORE_VERSIONED_DTOS",
    "telegram_may_recalculate_financial_values": false,
    "show_as_of_when_material": true,
    "explicit_states": [
      "READY",
      "PARTIAL",
      "STALE",
      "DEGRADED",
      "BLOCKED",
      "ERROR",
      "OFFLINE",
      "RECOVERING",
      "OWNER_ACTION_REQUIRED"
    ],
    "distinguish": [
      "broker_fact",
      "core_calculation",
      "external_evidence",
      "ai_inference",
      "unknown"
    ]
  },
  "alerts": {
    "severities": [
      "CRITICAL",
      "IMPORTANT",
      "INFO",
      "SILENT"
    ],
    "clean_watchtower_run_sends_message": false,
    "critical_bypasses_quiet_hours": true,
    "semantic_dedup": true,
    "delivery_idempotency": true,
    "edit_existing_incident_message_when_practical": true,
    "new_message_on": [
      "material_severity_escalation",
      "new_owner_action_required",
      "defined_reopen"
    ]
  },
  "delivery": {
    "durable_job": true,
    "states": [
      "PENDING",
      "SENDING",
      "DELIVERED",
      "RETRY_SCHEDULED",
      "RATE_LIMITED",
      "UNKNOWN_DELIVERY",
      "FAILED_PERMANENT"
    ],
    "persist_message_id": true,
    "persist_idempotency_key": true,
    "blind_retry_after_ambiguous_send": false,
    "sanitized_errors_only": true
  },
  "callbacks": {
    "opaque_callback_data_only": true,
    "contains_secret": false,
    "contains_full_portfolio_payload": false,
    "server_reauthorization_required": true,
    "server_state_revalidation_required": true,
    "stale_callback_fail_closed": true,
    "prompt_acknowledgement_required": true,
    "allowed_classes_block_f": [
      "refresh_summary",
      "show_incident",
      "show_status",
      "show_help",
      "open_web"
    ],
    "real_money_submit": "FORBIDDEN"
  },
  "identity": {
    "bot_chat": {
      "existing_omni_cio_account_required": true,
      "explicit_post_login_link_required": true,
      "private_chat_required": true,
      "server_side_binding": true,
      "can_create_omni_account": false,
      "can_mint_or_select_tenant": false,
      "can_replace_telegram_login": false
    },
    "mini_app": {
      "trusted_input": "server_validated_Telegram.WebApp.initData",
      "initDataUnsafe_trusted": false,
      "signature_hash_validation": true,
      "auth_date_freshness": true,
      "replay_rejection": true,
      "short_lived_v10_session": true,
      "ordinary_browser_auth_preserved": true,
      "omni_cio_account_mapping": true
    }
  },
  "deep_links": {
    "allowed_route_families": [
      "/portfolio",
      "/incidents/{opaque_ref}",
      "/research/{opaque_ref}",
      "/decisions/{opaque_ref}",
      "/system"
    ],
    "opaque_reference": true,
    "server_validated": true,
    "short_lived_or_signed_when_required": true,
    "url_possession_grants_authority": false,
    "forbidden_in_url": [
      "broker_token",
      "telegram_token",
      "full_account_id",
      "private_payload",
      "portfolio_value_as_authority"
    ]
  },
  "mini_app": {
    "frontend": "SAME_V10_WEB_CODEBASE",
    "separate_financial_logic": false,
    "telegram_shadow_db": false,
    "mobile_theme_support": true,
    "safe_area_support": true,
    "canonical_api_only": true
  },
  "ai": {
    "block_f_live_ai": false,
    "activation_owner": "WP32C",
    "brain": "SHARED_OMNI_CIO_CORTEX",
    "telegram_specific_model": false,
    "telegram_specific_knowledge_base": false,
    "broker_write_tool": false,
    "long_research": "DURABLE_RESEARCH_JOB",
    "provider_failure": "EXPLICIT_DEGRADED_MODE"
  },
  "degraded_behavior": {
    "ai_offline": "DETERMINISTIC_COMMANDS_CONTINUE_IF_CORE_READY",
    "market_stale": "BROKER_FACTS_REMAIN_AND_MARK_CURRENT_MARKET_STALE",
    "core_or_db_offline": "DO_NOT_INVENT_FROM_CHAT_CACHE",
    "telegram_api_offline": "CORE_CONTINUES_AND_DELIVERY_QUEUE_IS_BOUNDED",
    "node_restart": "RECOVER_CURSOR_AND_DURABLE_DELIVERY_STATE"
  },
  "privacy": {
    "telegram_is_canonical_portfolio_store": false,
    "persist_minimum_delivery_auth_audit_metadata": true,
    "raw_conversation_indefinite_retention_default": false,
    "full_account_id_user_facing": false,
    "raw_broker_report_through_telegram_default": false,
    "secrets_in_logs": false,
    "secrets_in_ai_context": false
  },
  "observability": [
    "polling_status",
    "last_processed_update",
    "authorized_denied_counts",
    "delivery_success_failure_rate_limit",
    "queue_depth_oldest_pending",
    "callback_stale_failure",
    "mini_app_auth_failure_replay",
    "send_edit_failure",
    "telegram_api_latency_error_class",
    "bot_contract_version"
  ],
  "explicit_non_goals": [
    "public_bot",
    "groups_channels",
    "payments",
    "managed_bots",
    "second_ai_brain",
    "second_financial_core",
    "telegram_trade_terminal",
    "photo_ocr_portfolio_import",
    "paid_bot_middleware_required_for_dod"
  ],
  "owner_participation": {
    "create_or_confirm_bot_once": true,
    "store_token_locally_once": true,
    "manual_mass_configuration": false,
    "powershell_if_local_action_needed": "ONE_REVIEWED_IDEMPOTENT_BLOCK_ADMIN_ONLY_IF_REQUIRED"
  },
  "official_references": [
    "https://core.telegram.org/bots/api",
    "https://core.telegram.org/bots/features",
    "https://core.telegram.org/bots/webapps",
    "https://core.telegram.org/bots/api-changelog"
  ],
  "login_separation": {
    "primary_human_login": "TELEGRAM_USER_ACCOUNT_OIDC",
    "login_scope": [
      "openid"
    ],
    "bot_access_scope_requested": false,
    "bot_chat_required": false,
    "bot_start_required": false,
    "bot_linking_stage": "POST_AUTH_ONLY",
    "bot_linking_owner": "WP23_PLUS"
  }
}
