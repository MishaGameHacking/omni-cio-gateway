{
  "registry": "V10_TELEGRAM_MESSAGE_REGISTRY",
  "version": "1.0.0",
  "status": "OWNER_APPROVED_PLANNING_ONLY",
  "rules": {
    "language_primary": "ru",
    "exact_financial_values_from_core_only": true,
    "material_as_of_required": true,
    "escape_untrusted_text": true,
    "full_account_id_forbidden": true,
    "secret_value_forbidden": true,
    "long_content_policy": "SUMMARY_PLUS_WEB_HANDOFF",
    "ai_output_must_distinguish_fact_calc_evidence_inference_unknown": true
  },
  "messages": [
    {
      "id": "TG_START_V1",
      "purpose": "Owner entry and concise product introduction",
      "required_fields": ["system_state", "owner_authorized"],
      "buttons": ["open_app", "show_status", "show_help"],
      "private_data_level": "MINIMAL"
    },
    {
      "id": "TG_HELP_V1",
      "purpose": "Supported commands, safety and handoff explanation",
      "required_fields": ["capability_flags"],
      "buttons": ["open_app"],
      "private_data_level": "NONE"
    },
    {
      "id": "TG_STATUS_V1",
      "purpose": "Compact V10/data readiness status",
      "required_fields": ["system_state", "core_state", "portfolio_data_state", "market_data_state", "as_of"],
      "optional_fields": ["watchtower_state", "ai_state", "active_incident_count", "release_id"],
      "buttons": ["refresh", "open_system", "open_app"],
      "private_data_level": "LOW"
    },
    {
      "id": "TG_PORTFOLIO_SUMMARY_V1",
      "purpose": "Compact canonical portfolio summary",
      "required_fields": ["portfolio_state", "broker_period_end_value", "currency", "broker_period_as_of"],
      "optional_fields": ["current_market_estimate", "market_as_of", "free_cash", "largest_position", "risk_summary"],
      "buttons": ["open_portfolio", "refresh"],
      "private_data_level": "MEDIUM",
      "constraints": ["no_full_position_table", "no_recalculation_in_template"]
    },
    {
      "id": "TG_ALERT_CRITICAL_V1",
      "purpose": "Immediate material incident notification",
      "required_fields": ["incident_ref", "title", "safe_summary", "detected_at", "incident_state", "source_class"],
      "optional_fields": ["owner_action_required", "as_of"],
      "buttons": ["open_incident"],
      "private_data_level": "MINIMIZED",
      "delivery": {"quiet_hours": false, "dedup": true, "edit_lifecycle": true}
    },
    {
      "id": "TG_ALERT_IMPORTANT_V1",
      "purpose": "Timely material incident notification",
      "required_fields": ["incident_ref", "title", "safe_summary", "detected_at", "incident_state"],
      "buttons": ["open_incident"],
      "private_data_level": "MINIMIZED",
      "delivery": {"quiet_hours": "POLICY_CONTROLLED", "dedup": true, "edit_lifecycle": true}
    },
    {
      "id": "TG_ALERT_INFO_V1",
      "purpose": "Non-urgent useful information",
      "required_fields": ["title", "safe_summary", "as_of"],
      "optional_fields": ["entity_ref"],
      "buttons": ["open_app"],
      "private_data_level": "MINIMIZED",
      "delivery": {"quiet_hours": true, "dedup": true}
    },
    {
      "id": "TG_INCIDENT_STATE_V1",
      "purpose": "Update an existing material incident message",
      "required_fields": ["incident_ref", "incident_state", "updated_at"],
      "optional_fields": ["safe_summary", "owner_action_required"],
      "buttons": ["open_incident"],
      "private_data_level": "MINIMIZED",
      "preferred_delivery": "EDIT_EXISTING_MESSAGE"
    },
    {
      "id": "TG_RESEARCH_READY_V1",
      "purpose": "Notify that a durable research job is complete",
      "required_fields": ["research_ref", "status", "completed_at", "source_count"],
      "optional_fields": ["contradiction_count", "safe_summary"],
      "buttons": ["open_research"],
      "private_data_level": "MINIMIZED"
    },
    {
      "id": "TG_AI_ANSWER_V1",
      "purpose": "Compact shared-Cortex answer for Telegram",
      "activation_owner": "WP32C",
      "required_fields": ["answer", "grounding_state"],
      "optional_fields": ["as_of", "source_refs", "tool_summary", "web_ref"],
      "buttons": ["open_details_if_available"],
      "private_data_level": "QUESTION_DEPENDENT_MINIMIZED",
      "constraints": ["no_broker_write", "no_invented_exact_financial_facts", "same_cortex_as_web"]
    },
    {
      "id": "TG_SYSTEM_DEGRADED_V1",
      "purpose": "Explain that a dependency is degraded and what remains trustworthy",
      "required_fields": ["system_state", "affected_component", "safe_effect", "started_at"],
      "optional_fields": ["last_good_as_of", "owner_action_required"],
      "buttons": ["open_system"],
      "private_data_level": "LOW"
    },
    {
      "id": "TG_SYSTEM_RECOVERED_V1",
      "purpose": "Close a previously material system degradation",
      "required_fields": ["affected_component", "recovered_at", "current_state"],
      "buttons": ["open_system"],
      "private_data_level": "LOW"
    },
    {
      "id": "TG_WEB_HANDOFF_V1",
      "purpose": "Provide exact authorized Web/Mini App handoff",
      "required_fields": ["route_type", "opaque_ref"],
      "buttons": ["open_app_route"],
      "private_data_level": "NONE_IN_URL",
      "constraints": ["server_validated_ref", "url_possession_not_authority"]
    },
    {
      "id": "TG_AUTH_DENIED_V1",
      "purpose": "Fail closed for unauthorized user/chat/session",
      "required_fields": ["denied_reason_class"],
      "buttons": [],
      "private_data_level": "NONE",
      "constraints": ["do_not_confirm_private_account_details", "do_not_leak_owner_identity"]
    }
  ],
  "button_actions": {
    "refresh": "READ_ONLY_REQUERY",
    "show_status": "READ_ONLY",
    "show_help": "READ_ONLY",
    "open_app": "NAVIGATION_ONLY",
    "open_system": "NAVIGATION_ONLY",
    "open_portfolio": "NAVIGATION_ONLY",
    "open_incident": "NAVIGATION_ONLY",
    "open_research": "NAVIGATION_ONLY",
    "open_details_if_available": "NAVIGATION_ONLY",
    "open_app_route": "NAVIGATION_ONLY"
  },
  "forbidden_button_actions": [
    "broker_submit",
    "withdraw",
    "transfer",
    "secret_rotation",
    "github_bypass",
    "windows_admin_shell",
    "implicit_real_money_approval"
  ]
}
