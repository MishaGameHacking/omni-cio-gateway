{
  "schema_version": "1",
  "work_package": "WP15",
  "name": "Deferred live READ acceptance through authenticated Web",
  "status": "SUPPORT_PATH_ONLY_UNTIL_OWNER_LIVE_EVIDENCE",
  "authority": {
    "master_plan": "docs/master-plan/OMNI_CIO_V10_MASTER_PLAN.md",
    "identity_amendment": "docs/master-plan/OMNI_CIO_V10_IDENTITY_MULTI_TENANT_ACCOUNT_AND_AUTHENTICATION_AMENDMENT.md",
    "wp15_contract": "docs/architecture/V10_WP15_TINVEST_READONLY_CONTRACT.md",
    "wp17_contract": "docs/architecture/V10_WP17_APPLICATION_SHELL_CONTRACT.json",
    "operations_runbook": "docs/operations/V10_WP15_OWNER_LIVE_READ_RUNBOOK.md"
  },
  "scope": {
    "normal_surface": "Settings -> Broker Connections",
    "acceptance_only": true,
    "portfolio_dashboard_feature_work": false,
    "public_ingress": false,
    "public_multi_user": false,
    "loopback_bind": "127.0.0.1",
    "trusted_hosts": [
      "127.0.0.1",
      "localhost"
    ],
    "private_test_identity_is_not_a_login_provider": true
  },
  "broker": {
    "provider": "t_invest",
    "credential_role": "READ",
    "required_account_access_level": "READ_ONLY",
    "selected_account_binding": "PREVIOUSLY_VERIFIED_BROKER_CONNECTION_ACCOUNT_FINGERPRINT",
    "adapter": "TInvestConnectionReadAdapter",
    "full_access_fallback": false,
    "trade_credential_allowed": false,
    "write_authority_added": false,
    "transfer_withdrawal_authority": false
  },
  "private_browser_challenge": {
    "ttl_seconds": 600,
    "maximum_ttl_seconds": 1800,
    "durable": false,
    "cache_control": "no-store",
    "fields": [
      "masked_account",
      "READ_ONLY",
      "portfolio_total_and_currency",
      "one_sample_position_label_quantity_unit_price_market_value_currency",
      "freshness_state_and_timestamps"
    ]
  },
  "owner_confirmation": {
    "required": [
      "intended_masked_account_confirmed",
      "portfolio_summary_parity",
      "sample_position_quantity_value_parity",
      "freshness_confirmed"
    ],
    "all_must_be_true": true,
    "synthetic_substitution_allowed": false
  },
  "pending_evidence": {
    "runtime_path": "C:\\ProgramData\\OmniCIO\\runtime\\wp15-live\\pending\\owner-confirmation.json",
    "runtime_can_write": true,
    "runner_can_read": false,
    "runner_can_write": false,
    "contains_private_values": false,
    "contains_raw_secret": false
  },
  "final_evidence": {
    "path": "C:\\ProgramData\\OmniCIO\\wp15-live\\owner-live-read-evidence.sanitized.local.json",
    "owner_admin_write_only": true,
    "runtime_write_allowed": false,
    "runner_read_allowed": true,
    "runner_write_allowed": false,
    "implementation_sha_required": true,
    "script_hash_binding_required": true,
    "forbidden_fields": [
      "token",
      "secret",
      "ciphertext",
      "broker_account_id",
      "account_fingerprint",
      "masked_account",
      "portfolio_total",
      "quantity",
      "unit_price",
      "market_value",
      "position_payload",
      "private_portfolio_payload"
    ]
  },
  "windows_runtime": {
    "principal": "omni-cio-runtime",
    "administrator_allowed": false,
    "temporary_task": "OmniCIO.V10.WP15LiveAcceptance",
    "task_logon": "PASSWORD",
    "acceptance_starter": "infrastructure/windows/start_wp15_live_web_acceptance.ps1",
    "temporary_batch_logon_right": "SeBatchLogonRight",
    "deny_batch_logon_right_rejected": true,
    "preexisting_batch_logon_right_preserved": true,
    "temporary_batch_logon_right_removed_before_starter_exit": true,
    "runtime_session_probe_before_http": true,
    "session_probe_residue": false,
    "s4u_allowed": false,
    "generated_runtime_password_logged_or_exported": false,
    "cleanup_disables_runtime_anchor": true,
    "permanent_wp9_web_slot_modified": false
  },
  "postgresql": {
    "major": 18,
    "database": "omni_cio_v10",
    "role": "omni_cio_runtime",
    "host": "127.0.0.1",
    "authentication": "SSPI",
    "hba_scope": "EXACT_DATABASE_EXACT_ROLE_LOOPBACK_ONLY",
    "username_mapping": true,
    "sspi_include_realm": true,
    "sspi_compat_realm": true,
    "sspi_upn_username": false,
    "principal_mapping_form": "SAM_USERNAME@SAM_REALM",
    "owner_admin_mapping_temporary": true,
    "owner_identity_seed_before_runtime": true,
    "owner_identity_seed_authority": "TEMPORARY_OWNER_ADMIN_ONLY",
    "runtime_owner_identity_write_authority": false,
    "runtime_mapping_only_after_bootstrap": true,
    "long_lived_web_connection_autocommit": true,
    "request_transaction_boundaries_explicit": true,
    "runtime_ddl_authority": false,
    "trust_allowed": false,
    "database_password_persisted": false,
    "postgres_admin_password_in_cli_or_logs_allowed": false
  },
  "ci": {
    "support_workflow": ".github/workflows/v10-wp15-live-web-support-audit.yml",
    "owner_audit_workflow": ".github/workflows/v10-wp15-live-web-owner-audit.yml",
    "owner_audit_trigger": "push_main_then_rerun_exact_sha_after_owner_finalization",
    "real_secret_in_ci": false
  },
  "exit_gate": {
    "code_security_ci_before_owner_action": true,
    "support_pr_merged_and_post_merge_regression_green_before_real_token": true,
    "owner_live_evidence_required": true,
    "independent_non_admin_runner_audit_required": true,
    "block_d_credit_before_live_evidence": false,
    "wp18_unlock_before_live_evidence": false
  },
  "invariants": {
    "gateway_entrypoint": "app:app",
    "trading_methods": false,
    "real_trading_enabled": false,
    "broker_write_authority_added": false,
    "protected_v9_rollback": true
  }
}
