{
  "schema_version": "1",
  "work_package": "WP17",
  "name": "Application Shell and navigation",
  "web_root": "apps/web",
  "api_root": "apps/api",
  "route_paths": [
    "/",
    "/portfolio",
    "/assets",
    "/watchtower",
    "/research",
    "/risks",
    "/decisions",
    "/plans",
    "/execution",
    "/journal",
    "/system",
    "/settings"
  ],
  "ordinary_login_providers": [
    "telegram"
  ],
  "local_password_allowed": false,
  "google_login_allowed": false,
  "session": {
    "server_side": true,
    "browser_cookie_http_only": true,
    "browser_cookie_same_site": "strict",
    "browser_storage_allowed": false,
    "revocation_required": true,
    "revoke_all_required": true,
    "private_test_identity_allowed_before_public_launch": true,
    "private_test_identity_loopback_only": true
  },
  "broker_connections": {
    "normal_surface": "Settings -> Broker Connections",
    "provider": "t_invest",
    "credential_role": "read",
    "raw_token_response_allowed": false,
    "raw_token_browser_storage_allowed": false,
    "raw_token_postgresql_allowed": false,
    "dpapi_ciphertext_postgresql_allowed": false,
    "secret_store": "WP8_WINDOWS_DPAPI_LOCAL_MACHINE",
    "secret_subtree": "C:\\ProgramData\\OmniCIO\\secrets\\read-broker\\connections",
    "runtime_write_scope": "READ_CONNECTION_CHILD_ONLY",
    "ci_secret_data_access": false,
    "full_or_unknown_broker_authority_allowed": false,
    "multiple_read_accounts_per_credential_allowed": true,
    "replace_requires_same_verified_account_set": true,
    "trade_credential_allowed": false,
    "transfer_or_withdrawal_allowed": false,
    "local_vault_authority": "HISTORICAL_LOCAL_ONLY"
  },
  "read_vault_acceptance": {
    "owner_admin_verify_required": true,
    "exact_head_binding_required": true,
    "script_hash_binding_required": true,
    "non_admin_runner_negative_probe_required": true,
    "runner_payload_read_allowed": false,
    "runner_payload_write_allowed": false,
    "runner_evidence_write_allowed": false,
    "authority": "HISTORICAL_LOCAL_ONLY",
    "blocks_timeweb_pr": false
  },
  "public_activation": {
    "public_registration": false,
    "public_multi_user": false,
    "public_internet_ingress": false,
    "external_tls_gate": "WP22A"
  },
  "deferred_wp15_live_acceptance": {
    "owner_real_token_required_before_wp17_code_gate": false,
    "normal_token_input": "AUTHENTICATED_WEB_ONLY",
    "wp18_real_data_unlock_requires_live_acceptance": true
  },
  "invariants": {
    "gateway_entrypoint": "app:app",
    "trading_methods": false,
    "REAL_TRADING_ENABLED": false,
    "broker_write_authority_added": false,
    "protected_v9_rollback": true
  },
  "timeweb_broker_custody": {
    "mode": "FAIL_CLOSED_PENDING_HOSTED_BACKEND",
    "local_windows_vault_dependency_allowed": false,
    "owner_admin_acl_evidence_required_for_timeweb_pr": false,
    "broker_mutation_enabled": false,
    "global_shared_credential_allowed": false,
    "required_pr_gate": "TIMEWEB_SOURCE_SECURITY_AUDIT"
  }
}
