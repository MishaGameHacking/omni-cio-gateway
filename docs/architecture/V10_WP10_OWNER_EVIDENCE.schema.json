{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omni-cio.local/schemas/v10-wp10-owner-evidence.schema.json",
  "title": "Omni-CIO V10 WP10 sanitized OWNER recovery evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_package",
    "evidence_class",
    "captured_at_utc",
    "target",
    "rehearsal",
    "privacy",
    "status",
    "reason_codes"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "work_package": {"const": "WP10"},
    "evidence_class": {"const": "OWNER_OFFDEVICE_RECOVERY"},
    "captured_at_utc": {"type": "string", "format": "date-time"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "non_system_volume",
        "bitlocker_fully_encrypted",
        "bitlocker_protection_on",
        "recovery_key_custody_confirmed",
        "target_marker_present",
        "runner_payload_read_denied",
        "runner_payload_write_denied"
      ],
      "properties": {
        "non_system_volume": {"type": "boolean"},
        "bitlocker_fully_encrypted": {"type": "boolean"},
        "bitlocker_protection_on": {"type": "boolean"},
        "recovery_key_custody_confirmed": {"type": "boolean"},
        "target_marker_present": {"type": "boolean"},
        "runner_payload_read_denied": {"type": "boolean"},
        "runner_payload_write_denied": {"type": "boolean"}
      }
    },
    "rehearsal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "postgres_major",
        "bundle_integrity_pass",
        "corruption_rejected",
        "offdevice_copy_pass",
        "separate_restore_database_used",
        "restore_probe_exact_match",
        "temporary_state_cleaned",
        "duration_ms"
      ],
      "properties": {
        "postgres_major": {"const": 18},
        "bundle_integrity_pass": {"type": "boolean"},
        "corruption_rejected": {"type": "boolean"},
        "offdevice_copy_pass": {"type": "boolean"},
        "separate_restore_database_used": {"type": "boolean"},
        "restore_probe_exact_match": {"type": "boolean"},
        "temporary_state_cleaned": {"type": "boolean"},
        "duration_ms": {"type": "integer", "minimum": 0, "maximum": 14400000}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_disk_identity_collected",
        "recovery_key_value_collected",
        "secret_value_collected",
        "account_identifier_collected",
        "private_portfolio_payload_collected",
        "private_database_archive_uploaded_to_ci"
      ],
      "properties": {
        "raw_disk_identity_collected": {"const": false},
        "recovery_key_value_collected": {"const": false},
        "secret_value_collected": {"const": false},
        "account_identifier_collected": {"const": false},
        "private_portfolio_payload_collected": {"const": false},
        "private_database_archive_uploaded_to_ci": {"const": false}
      }
    },
    "status": {"enum": ["PASS", "FAIL", "OWNER_ACTION_REQUIRED"]},
    "reason_codes": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Z0-9_:-]+$"},
      "uniqueItems": true
    }
  }
}
