{
  "schema_version": "1",
  "work_package": "WP8",
  "name": "Local Secret Store and rotation",
  "provider": {
    "type": "WINDOWS_DPAPI",
    "api": "System.Security.Cryptography.ProtectedData",
    "scope": "LOCAL_MACHINE",
    "authorization_boundary": "PROTECTED_NTFS_DACL",
    "local_machine_scope_is_not_principal_authorization": true,
    "additional_entropy": "NONE",
    "plaintext_cli_allowed": false,
    "plaintext_environment_allowed": false,
    "plaintext_log_allowed": false,
    "secret_hash_metadata_allowed": false,
    "ciphertext_in_github_allowed": false
  },
  "paths": {
    "secret_root": "C:\\ProgramData\\OmniCIO\\secrets",
    "evidence_root": "C:\\ProgramData\\OmniCIO\\wp8",
    "wp6_execution_sentinel": "C:\\ProgramData\\OmniCIO\\secrets\\execution\\wp6-ci-deny-sentinel.txt"
  },
  "identities": {
    "runtime_role": "omni-cio-runtime",
    "execution_role": "omni-cio-execution",
    "ci_runner_role": "SELF_HOSTED_RUNNER_SERVICE_IDENTITY",
    "owner_role": "OWNER_ADMIN",
    "system_role": "SYSTEM"
  },
  "secret_classes": [
    {
      "id": "broker_read",
      "directory": "C:\\ProgramData\\OmniCIO\\secrets\\read-broker",
      "active_blob": "broker-read.dpapi",
      "sentinel_blob": "wp8-rotation-sentinel.dpapi",
      "owner": "OWNER_ADMIN",
      "purpose": "V10 production read-only broker credential",
      "scope": "LOCAL_NODE",
      "consumer_role": "omni-cio-runtime",
      "consumer_data_access": "READ",
      "real_value_required_for_wp8": false,
      "rotation_rehearsal_required": true
    },
    {
      "id": "broker_trading",
      "directory": "C:\\ProgramData\\OmniCIO\\secrets\\execution\\wp8-trading",
      "active_blob": "broker-trading.dpapi",
      "sentinel_blob": "wp8-rotation-sentinel.dpapi",
      "owner": "OWNER_ADMIN",
      "purpose": "Future isolated Real BUY/SELL broker credential without transfer authority",
      "scope": "LOCAL_NODE_EXECUTION_ONLY",
      "consumer_role": "omni-cio-execution",
      "consumer_data_access": "READ",
      "real_value_required_for_wp8": false,
      "rotation_rehearsal_required": false
    },
    {
      "id": "telegram_bot",
      "directory": "C:\\ProgramData\\OmniCIO\\secrets\\telegram",
      "active_blob": "telegram-bot.dpapi",
      "sentinel_blob": "wp8-rotation-sentinel.dpapi",
