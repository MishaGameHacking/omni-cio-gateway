      "purpose": "Future Telegram bot credential",
      "scope": "LOCAL_NODE",
      "consumer_role": "SEALED_UNTIL_BLOCK_F",
      "consumer_data_access": "NONE",
      "real_value_required_for_wp8": false,
      "rotation_rehearsal_required": true
    },
    {
      "id": "local_encryption_key",
      "directory": "C:\\ProgramData\\OmniCIO\\secrets\\encryption",
      "active_blob": "local-encryption-key.dpapi",
      "sentinel_blob": "wp8-rotation-sentinel.dpapi",
      "owner": "OWNER_ADMIN",
      "purpose": "Future local encryption or recovery-key material",
      "scope": "LOCAL_NODE",
      "consumer_role": "SEALED_UNTIL_OWNING_WP",
      "consumer_data_access": "NONE",
      "real_value_required_for_wp8": false,
      "rotation_rehearsal_required": false
    },
    {
      "id": "external_source",
      "directory": "C:\\ProgramData\\OmniCIO\\secrets\\external",
      "active_blob": "external-source.dpapi",
      "sentinel_blob": "wp8-rotation-sentinel.dpapi",
      "owner": "OWNER_ADMIN",
      "purpose": "Future approved external research/source credential",
      "scope": "LOCAL_NODE",
      "consumer_role": "SEALED_UNTIL_OWNING_WP",
      "consumer_data_access": "NONE",
      "real_value_required_for_wp8": false,
      "rotation_rehearsal_required": false
    }
  ],
  "acl": {
    "inheritance_protected": true,
    "system_rights": "FULL_CONTROL",
    "administrators_rights": "FULL_CONTROL",
    "consumer_rights": "READ_ONLY",
    "ci_runner_directory_rights": [
      "READ_PERMISSIONS",
      "READ_ATTRIBUTES",
      "TRAVERSE"
    ],
    "ci_runner_file_rights": [
      "READ_PERMISSIONS",
      "READ_ATTRIBUTES"
    ],
    "ci_runner_read_data_allowed": false,
    "ci_runner_write_allowed": false,
    "broad_read_principals_allowed": false
  },
  "lifecycle": {
    "states": [
      "UNPROVISIONED",
      "ACTIVE",
      "REVOKED",
      "COMPROMISED"
    ],
    "metadata_fields": [
      "schema_version",
      "secret_class",
      "owner",
      "purpose",
      "scope",
      "consumer_role",
      "state",
      "version",
      "rotation_procedure",
      "revocation_procedure",
      "compromised",
      "provisioned"
    ],
    "forbidden_metadata_fields": [
      "value",
      "secret_value",
      "ciphertext",
      "hash",
      "digest",
      "fingerprint",
      "sid",
      "username",
      "hostname",
      "account_id"
    ],
    "real_value_change_requires_owner_admin": true,
    "real_value_change_forbidden_in_github_actions": true,
    "secret_input_mode": "READ_HOST_AS_SECURE_STRING",
    "recovery_material_separate_from_github_and_backup": true
  },
  "acceptance": {
    "real_secret_values_used": false,
    "persistent_sentinels_are_non_secret": true,
    "rotation_rehearsal_classes": [
      "broker_read",
      "telegram_bot"
    ],
    "unauthorized_runner_data_read_expected": "ACCESS_DENIED",
    "rollback_must_refuse_if_real_secret_provisioned": true,
    "secret_root_artifact_upload_allowed": false,
    "process_dump_collection_during_secret_change_allowed": false,
    "future_service_activation_allowed": false,
    "broker_write_activation_allowed": false,
    "trading_methods": false,
    "gateway_entrypoint": "app:app"
  }
}
