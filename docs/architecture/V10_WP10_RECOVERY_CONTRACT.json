{
  "schema_version": "1",
  "work_package": "WP10",
  "title": "Backup, restore and off-device recovery",
  "accepted_base_reference": "STATUS_PR_262",
  "authority": {
    "master_plan": "docs/master-plan/OMNI_CIO_V10_MASTER_PLAN.md",
    "recovery_contract": "docs/architecture/V10_RECOVERY_CONTRACT.md",
    "wp8_protected_store_contract": "docs/architecture/V10_WP8_SECRET_STORE_CONTRACT.json",
    "wp9a_operations_contract": "docs/architecture/V10_WP9A_OPERATIONS_CONTRACT.json",
    "stable_entrypoint": "app:app",
    "trading_methods": false,
    "real_trading_enabled": false,
    "real_money_authority_change": false
  },
  "recovery_objectives": {
    "rpo_minutes": 60,
    "rto_minutes": 240,
    "rpo_applies_after_product_db_binding": true,
    "off_device_freshness_required_for_rpo": true,
    "rto_never_bypasses_integrity_or_reconciliation": true
  },
  "source_separation": {
    "engineering_source": "GITHUB_ACCEPTED_MAIN_RELEASE",
    "private_durable_state": "ENCRYPTED_OWNER_CONTROLLED_BACKUP",
    "runtime_protected_store_recovery": "SEPARATELY_RESTORED_LOCAL_SECRET_STORE",
    "github_is_private_state_backup": false,
    "github_is_secret_backup": false,
    "ci_artifact_is_private_state_backup": false
  },
  "postgresql": {
    "accepted_major": 18,
    "accepted_floor": "18.4",
    "backup_tool": "pg_dump",
    "restore_tool": "pg_restore",
    "archive_format": "CUSTOM",
    "archive_extension": ".dump",
    "required_dump_flags": [
      "--format=custom",
      "--no-owner",
      "--no-privileges"
    ],
    "restore_list_check_required": true,
    "restore_into_controlled_recovery_database": true,
    "cluster_role_password_backup_forbidden": true,
    "production_database_binding": "NOT_READY_UNTIL_WP13",
    "synthetic_rehearsal_required_now": true,
    "real_private_database_required_for_wp10_acceptance": false
  },
  "integrity": {
    "algorithm": "SHA256",
    "archive_size_bound": true,
    "manifest_schema_bound": true,
    "hash_before_restore_required": true,
    "destination_rehash_before_promotion_required": true,
    "atomic_final_promotion_required": true,
    "corruption_rehearsal_required": true
  },
  "bundle": {
    "archive_name_pattern": "wp10-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{12}\\.dump",
    "manifest_suffix": ".manifest.json",
    "temporary_suffix": ".partial",
    "manifest_allowed_fields": [
      "schema_version",
      "backup_class",
      "created_at_utc",
      "archive_name",
      "archive_sha256",
      "archive_size_bytes",
      "postgres_major",
      "postgres_version_class",
      "archive_format",
      "retention_class"
    ],
    "manifest_forbidden_fields": [
      "secret",
      "token",
      "password",
      "authorization",
      "ciphertext",
      "recovery_key",
      "account_id",
      "portfolio_payload",
      "database_password",
      "connection_string",
      "raw_username",
      "hostname",
      "ip_address"
    ]
  },
  "retention": {
    "cadence_minutes_after_product_binding": 60,
    "maximum_successful_bundles_per_target": 72,
    "maximum_age_days": 30,
    "never_delete_only_verified_bundle": true,
    "unknown_or_unowned_file_deletion_forbidden": true,
    "manifest_validity_required_before_prune": true
  },
  "local_staging": {
    "encrypted_system_volume_required": true,
    "plaintext_secret_material_forbidden": true,
    "production_runner_read_access": false,
    "synthetic_ci_rehearsal_may_use_runner_temp": true,
    "synthetic_ci_contains_private_data": false
  },
  "off_device": {
    "initial_target_class": "BITLOCKER_OWNER_CONTROLLED_NON_SYSTEM_VOLUME",
    "system_volume_allowed": false,
    "bitlocker_volume_status_required": "FullyEncrypted",
    "bitlocker_protection_status_required": "On",
    "recovery_key_custody_separate_required": true,
    "target_marker_required": true,
    "target_marker_name": ".omni-cio-wp10-target.json",
    "runner_backup_payload_read_allowed": false,
    "runtime_backup_payload_read_allowed_now": false,
    "runtime_backup_payload_write_allowed_now": false,
    "production_backup_writer_identity": "NOT_READY_UNTIL_PRODUCT_DB_AND_BACKUP_JOB_BINDING",
    "backup_root_name": "OmniCIO-WP10-Backups",
    "owner_physical_action_required_for_final_acceptance": true,
    "owner_synthetic_copy_restore_rehearsal_required": true,
    "owner_rehearsal_evidence_required": true,
    "nonadmin_runner_read_write_denial_required": true
  },
  "private_metadata": {
    "mode": "ALLOWLIST_ONLY",
    "empty_payload_allowed_before_owning_wps": true,
    "protected_store_root": "C:\\ProgramData\\OmniCIO\\secrets",
    "secret_root_backup_forbidden": true,
    "wp8_ciphertext_backup_forbidden": true,
    "recovery_key_backup_forbidden": true,
    "runner_private_config_backup_forbidden": true,
    "process_dump_backup_forbidden": true
  },
  "rehearsal": {
    "postgres_synthetic_cluster": true,
    "real_secret_values_used": false,
    "private_portfolio_data_used": false,
    "source_and_restore_database_separate": true,
    "corrupted_archive_must_be_rejected": true,
    "restored_probe_must_match_exactly": true,
    "temporary_state_cleanup_required": true
  },
  "observability": {
    "allowed_states": [
      "READY",
      "NOT_READY_ALLOWED",
      "DEGRADED",
      "BLOCKED",
      "ERROR"
    ],
    "private_archive_upload_to_ci_forbidden": true,
    "secret_or_recovery_key_log_forbidden": true,
    "off_device_file_listing_upload_forbidden": true,
    "sanitized_boolean_and_reason_evidence_only": true
  },
  "next_wp": {
    "wp": "WP11",
    "requires_wp10_exit_gate": true,
    "requires_block_c_acceptance": true,
    "early_start_forbidden": true
  }
}
