{
  "schema_version": "2",
  "work_package": "WP10",
  "status": "IN_PROGRESS_OWNER_GATE_REQUIRED",
  "authority": {
    "master_plan": "docs/master-plan/OMNI_CIO_V10_MASTER_PLAN.md",
    "recovery_contract": "docs/architecture/V10_RECOVERY_CONTRACT.md",
    "stable_entrypoint": "app:app",
    "trading_methods": false,
    "real_trading_enabled": false,
    "broker_authority_change": false
  },
  "recovery_objectives": {
    "rpo_minutes": 60,
    "rto_minutes": 240,
    "rpo_status_before_product_db_binding": "NOT_APPLICABLE_YET",
    "rpo_requires_offdevice_copy": true,
    "rto_requires_integrity_checks": true,
    "measured_owner_rehearsal_required": true
  },
  "source_separation": {
    "engineering_source": "GITHUB_ACCEPTED_MAIN_RELEASE",
    "private_durable_state": "ENCRYPTED_OWNER_CONTROLLED_OFFDEVICE_BACKUP",
    "runtime_secrets": "SEPARATELY_RESTORED_OWNER_CONTROLLED_SECRET_STORE",
    "github_is_private_state_backup": false,
    "github_is_secret_backup": false,
    "ci_artifact_is_private_state_backup": false
  },
  "postgresql": {
    "accepted_major": 18,
    "backup_tool": "pg_dump",
    "restore_tool": "pg_restore",
    "archive_format": "CUSTOM",
    "required_dump_flags": [
      "--format=custom",
      "--no-owner",
      "--no-privileges"
    ],
    "restore_list_preflight_required": true,
    "restore_into_separate_database_required": true,
    "synthetic_rehearsal_required_now": true,
    "production_database_binding": "NOT_READY_UNTIL_WP13",
    "production_job_binding": "NOT_READY_UNTIL_WP13_WP14",
    "automation_mechanism_required_now": true
  },
  "automation": {
    "target_cadence_minutes": 60,
    "cadence_must_not_exceed_rpo": true,
    "noninteractive_runner_required": true,
    "schedule_definition_required_now": true,
    "synthetic_schedule_rehearsal_required_now": true,
    "production_schedule_activation_before_product_binding": false,
    "secret_values_in_task_definition_forbidden": true
  },
  "integrity": {
    "algorithm": "SHA256",
    "archive_size_bound": true,
    "manifest_schema_bound": true,
    "hash_before_restore_required": true,
    "destination_rehash_required": true,
    "atomic_promotion_required": true,
    "corrupt_backup_rejection_required": true
  },
  "bundle": {
    "archive_name_pattern": "wp10-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{12}\\.dump",
    "manifest_suffix": ".manifest.json",
    "temporary_suffix": ".partial",
    "allowed_manifest_fields": [
      "schema_version",
      "backup_class",
      "created_at_utc",
      "archive_name",
      "archive_sha256",
      "archive_size_bytes",
      "postgres_major",
      "postgres_version_class",
      "archive_format",
      "retention_class"
    ],
    "forbidden_manifest_tokens": [
      "secret",
      "token",
      "password",
      "authorization",
      "ciphertext",
      "recovery_key",
      "account_id",
      "portfolio_payload",
      "connection_string",
      "hostname",
      "ip_address"
    ]
  },
  "retention": {
    "maximum_successful_bundles_per_target": 72,
    "maximum_age_days": 30,
    "never_delete_only_verified_bundle": true,
    "unknown_or_invalid_content_deletion_forbidden": true,
    "verify_immediately_before_delete": true
  },
  "private_metadata": {
    "mode": "EXPLICIT_ALLOWLIST_ONLY",
    "empty_payload_allowed_before_owning_wps": true,
    "synthetic_allowlist_test_required_now": true,
    "forbidden_path_tokens": [
      "secrets",
      "token",
      "password",
      "recovery",
      "private_key",
      "runner",
      "dump"
    ]
  },
  "off_device": {
    "initial_target_class": "OWNER_CONTROLLED_NON_SYSTEM_BITLOCKER_VOLUME",
    "owner_target_required_for_final_acceptance": true,
    "system_volume_allowed": false,
    "fully_encrypted_required": true,
    "protection_on_required": true,
    "separate_recovery_key_custody_required": true,
    "target_marker_name": ".omni-cio-wp10-target.json",
    "backup_root_name": "OmniCIO-WP10-Backups",
    "destructive_provisioning_by_wp10_forbidden": true,
    "format_disk_forbidden": true,
    "repartition_disk_forbidden": true,
    "shrink_volume_forbidden": true,
    "runner_payload_read_allowed": false,
    "runner_payload_write_allowed": false,
    "owner_copy_restore_rehearsal_required": true,
    "ci_may_synthesize_owner_evidence": false
  },
  "owner_evidence": {
    "required_state_before_final_acceptance": "PASS",
    "missing_evidence_state": "OWNER_ACTION_REQUIRED",
    "sanitized_only": true,
    "raw_disk_identity_forbidden": true,
    "recovery_key_value_forbidden": true,
    "secret_value_forbidden": true,
    "private_payload_forbidden": true,
    "measured_duration_required": true
  },
  "rehearsal": {
    "synthetic_database_required": true,
    "private_portfolio_data_used": false,
    "real_secret_values_used": false,
    "corrupt_copy_must_be_rejected": true,
    "separate_restore_database_required": true,
    "restored_probe_exact_match_required": true,
    "temporary_state_cleanup_required": true
  },
  "acceptance": {
    "software_tests_required": true,
    "lenovo_synthetic_recovery_required": true,
    "owner_physical_recovery_required": true,
    "repository_required_checks_green": true,
    "zero_unresolved_review_threads": true,
    "squash_merge_only": true,
    "post_merge_regression_shield_required": true,
    "wp11_locked_until_complete": true
  }
}
