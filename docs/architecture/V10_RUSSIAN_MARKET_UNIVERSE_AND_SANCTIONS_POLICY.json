{
  "schema_version": "1.0.0",
  "status": "owner-approved-planning-baseline",
  "product_scope": "Russian-market-only candidate universe",
  "universe_pipeline": [
    "BROKER_DISCOVERED",
    "IDENTITY_NORMALIZED",
    "RUSSIAN_MARKET_POLICY",
    "SANCTIONS_CUSTODY_POLICY",
    "USER_BROKER_ELIGIBILITY",
    "NO_MARGIN_NO_SHORT",
    "LIQUIDITY_DATA_QUALITY",
    "ASSET_CLASS_RULES",
    "V10_ALLOWED_UNIVERSE"
  ],
  "broker_availability_is_sufficient_for_v10_eligibility": false,
  "russian_market_classification_inputs": [
    "issuer_or_obligor_jurisdiction",
    "primary_or_supported_trading_venue",
    "instrument_legal_structure",
    "custody_and_settlement_chain",
    "payment_and_settlement_characteristics",
    "broker_instrument_identity"
  ],
  "sanctions": {
    "states": [
      "CLEAR",
      "WATCH",
      "AMBIGUOUS",
      "RESTRICTED",
      "BLOCKED",
      "DATA_STALE"
    ],
    "blocked_new_buy_candidate": true,
    "restricted_or_ambiguous_auto_clear_allowed": false,
    "ownership_control_relationships_must_be_supported": true,
    "naive_name_only_matching_sufficient": false,
    "evidence_fields": [
      "source_identity",
      "source_jurisdiction_or_list",
      "list_or_dataset_version",
      "published_or_effective_at",
      "retrieved_at",
      "instrument_or_issuer_identity",
      "match_rationale",
      "ownership_or_control_rationale_if_applicable",
      "freshness_state"
    ],
    "held_instrument_becoming_restricted_behavior": "open_incident_and_review; do_not_blindly_force_sell_without_execution_legal_market_and_settlement_checks"
  },
  "custody_risk": {
    "russian_asset_means_zero_freeze_risk": false,
    "dimensions": [
      "custody_chain",
      "settlement_infrastructure",
      "foreign_infrastructure_dependency",
      "payment_mechanism",
      "venue_dependency",
      "sanctions_exposure"
    ]
  },
  "currency_and_bond_exposure": {
    "separate_fields_required": [
      "settlement_currency",
      "nominal_currency",
      "coupon_or_payment_currency",
      "reference_or_index_currency",
      "fx_linked_payout_mechanism",
      "economic_fx_exposure",
      "custody_payment_infrastructure"
    ],
    "rub_settlement_implies_no_fx_exposure": false
  },
  "screening_strategy": {
    "full_universe_may_be_large": true,
    "staged_screening_required": true,
    "deep_research_all_instruments_every_cycle": false,
    "cortex_only_for_selected_evidence_gaps_or_complex_interpretation": true
  },
  "hard_blocks": [
    "SANCTIONS_BLOCKED",
    "UNSUPPORTED_OR_UNTRADABLE",
    "MARGIN_OR_UNCOVERED_SHORT_REQUIRED",
    "CRITICAL_IDENTITY_OR_DATA_INTEGRITY_FAILURE",
    "CRITICAL_FRESHNESS_REQUIRED_BUT_MISSING"
  ],
  "source_policy": {
    "prefer_primary_and_official": true,
    "examples": [
      "broker_instrument_and_account_data",
      "MOEX",
      "Bank_of_Russia_or_regulator",
      "issuer_official_disclosure",
      "official_sanctions_list_sources",
      "other_primary_sources"
    ],
    "secondary_media_may_contextualize_but_not_override_primary_facts": true
  }
}
