{
  "schema_version": "1",
  "status": "wp7-bootstrap-policy",
  "bootstrap": {
    "script": "infrastructure/windows/bootstrap-v10.ps1",
    "default_mode": "PREVIEW",
    "mutation_switch": "Apply",
    "verification_switch": "Verify",
    "requires_windows_for_apply": true,
    "requires_owner_administrator_for_apply": true,
    "accepts_secret_values": false,
    "runner_registration_allowed": false,
    "future_application_service_activation_allowed": false
  },
  "toolchain": {
    "authority": "docs/architecture/V10_TOOLCHAIN_BASELINE.json",
    "python": {
      "runtime_version": "3.14.6",
      "winget_id": "Python.Python.3.14",
      "winget_version": "3.14.6",
      "install_policy": "EXACT_VERSION_OWNER_ASSISTED"
    },
    "node": {
      "runtime_version": "24.18.0",
      "winget_id": "OpenJS.NodeJS.LTS",
      "winget_version": "24.18.0",
      "install_policy": "EXACT_VERSION_PUBLIC_PACKAGE"
    },
    "npm": {
      "runtime_version": "11.16.0",
      "install_policy": "VERIFY_WITH_NODE_BASELINE"
    },
    "postgresql": {
      "major": 18,
      "runtime_version": "18.4",
      "winget_id": "PostgreSQL.PostgreSQL.18",
      "winget_version": "18.4-2",
      "install_policy": "EXACT_VERSION_OWNER_ASSISTED_NO_PASSWORD_ARGUMENT"
    }
  },
  "paths": {
    "root": "C:\\ProgramData\\OmniCIO",
    "bootstrap_state": "C:\\ProgramData\\OmniCIO\\bootstrap",
    "runtime": "C:\\ProgramData\\OmniCIO\\runtime",
    "data": "C:\\ProgramData\\OmniCIO\\data",
    "logs": "C:\\ProgramData\\OmniCIO\\logs",
    "services": "C:\\ProgramData\\OmniCIO\\services",
    "secret_root_owned_by_wp8": "C:\\ProgramData\\OmniCIO\\secrets",
    "runner_root_external": "C:\\actions-runner"
  },
  "wp6_roles": {
    "runtime": "omni-cio-runtime",
    "execution": "omni-cio-execution",
    "required_present": true,
    "required_enabled": false,
    "required_administrator": false
  },
  "runner": {
    "checker": "scripts/check_self_hosted_windows_runner_service.ps1",
    "expected_name": "omni-cio-ci",
    "root": "C:\\actions-runner",
    "must_be_healthy": true,
    "must_remain_persistent_service": true
  },
  "owned_markers": {
    "bootstrap_marker_filename": "wp7-bootstrap-state.json",
    "directory_marker_filename": ".omni-cio-wp7-owned",
    "marker_value": "OMNI-CIO-V10-WP7-NON-SECRET-OWNED-v1"
  },
  "service_definitions": [
    {
      "id": "core-runtime",
      "identity_role": "omni-cio-runtime",
      "activation": "FUTURE_WP_ONLY"
    },
    {
      "id": "web-api",
      "identity_role": "omni-cio-runtime",
      "activation": "FUTURE_WP_ONLY"
    },
    {
      "id": "research-ai",
      "identity_role": "omni-cio-runtime",
      "activation": "FUTURE_WP_ONLY"
    },
    {
      "id": "execution",
      "identity_role": "omni-cio-execution",
      "activation": "FUTURE_WP_ONLY"
    }
  ],
  "forbidden_secret_parameters": [
    "token",
    "secret",
    "password",
    "api_key",
    "authorization",
    "connection_string"
  ],
  "forbidden_mutation_roots": [
    "C:\\actions-runner\\.runner",
    "C:\\actions-runner\\.credentials",
    "C:\\actions-runner\\.credentials_rsaparams",
    "C:\\actions-runner\\.service",
    "C:\\ProgramData\\OmniCIO\\secrets"
  ],
  "profile": {
    "schema_version": "1",
    "allowed_prerequisite_states": [
      "MATCH",
      "MISSING",
      "MISMATCH",
      "UNAVAILABLE"
    ],
    "allowed_bootstrap_states": [
      "PASS",
      "OWNER_ACTION_REQUIRED",
      "FAIL"
    ],
    "privacy_flags_required_false": [
      "raw_usernames_collected",
      "sids_emitted",
      "hostnames_collected",
      "addresses_collected",
      "secret_values_collected",
      "runner_credentials_collected",
      "private_data_collected"
    ]
  },
  "exit_gate": {
    "runner_healthy": true,
    "wp6_roles_valid": true,
    "owned_directories_ready": true,
    "service_definitions_ready": true,
    "prerequisites_exact": true,
    "repeat_apply_idempotent": true,
    "secret_values_absent": true,
    "future_services_inactive": true
  }
}
