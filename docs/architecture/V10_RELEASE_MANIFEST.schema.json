{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omni-cio.local/schemas/v10-release-manifest.schema.json",
  "title": "Omni-CIO V10 Release Manifest",
  "description": "Planning-time canonical schema for reproducible V10 release identity. WP4 implements generation/validation; this schema does not itself start WP4.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_version",
    "git_sha",
    "build",
    "toolchain",
    "dependency_locks",
    "contracts",
    "sbom",
    "ci_evidence",
    "rollback"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "release_version": {
      "type": "string",
      "pattern": "^v10\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "release_tag": {
      "type": "string",
      "pattern": "^v10\\."
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["built_at_utc", "workflow_name", "workflow_run_id", "source_ref"],
      "properties": {
        "built_at_utc": {"type": "string", "format": "date-time"},
        "workflow_name": {"type": "string", "minLength": 1},
        "workflow_run_id": {"type": ["integer", "string"]},
        "source_ref": {"type": "string", "minLength": 1},
        "builder_class": {"type": "string", "enum": ["github_hosted", "self_hosted", "hybrid"]}
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python"],
      "properties": {
        "python": {"type": "string", "minLength": 1},
        "node": {"type": ["string", "null"]},
        "npm": {"type": ["string", "null"]},
        "os_compatibility": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "dependency_locks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/digest_file"}
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_schema", "db_schema", "broker_parser", "security_policy"],
      "properties": {
        "api_schema": {"type": ["string", "null"]},
        "db_schema": {"type": ["string", "null"]},
        "broker_parser": {"type": ["string", "null"]},
        "security_policy": {"type": "string", "minLength": 1},
        "program_plan_revision": {"type": ["string", "null"]}
      }
    },
    "sbom": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/digest_file"},
          {
            "type": "object",
            "properties": {
              "format": {"type": "string", "enum": ["cyclonedx-json", "spdx-json", "other"]}
            },
            "required": ["format"]
          }
        ]
      }
    },
    "ai": {
      "description": "Optional until Block G. If present, binds the local Cortex model/policy/adapter identity to the release.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["enabled", "policy_version"],
      "properties": {
        "enabled": {"type": "boolean"},
        "provider_runtime": {"type": ["string", "null"]},
        "base_model": {"type": ["string", "null"]},
        "model_digest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "quantization": {"type": ["string", "null"]},
        "context_tokens": {"type": ["integer", "null"], "minimum": 1},
        "policy_version": {"type": "string", "minLength": 1},
        "adapter_digest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "eval_contract": {"type": ["string", "null"]},
        "eval_result": {"type": ["string", "null"], "enum": ["PASS", "FAIL", "NOT_APPLICABLE", null]}
      }
    },
    "ci_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoritative_gate", "regression_shield"],
      "properties": {
        "authoritative_gate": {"$ref": "#/$defs/ci_run"},
        "regression_shield": {"$ref": "#/$defs/ci_run"},
        "hosted_compatibility": {
          "type": "array",
          "items": {"$ref": "#/$defs/ci_run"}
        }
      }
    },
    "bootstrap": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "version": {"type": ["string", "null"]},
        "compatibility": {"type": ["string", "null"]},
        "recovery_contract_version": {"type": ["string", "null"]}
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "instructions_ref"],
      "properties": {
        "target": {"type": "string", "minLength": 1},
        "instructions_ref": {"type": "string", "minLength": 1},
        "database_constraints": {"type": ["string", "null"]},
        "ai_rollback": {"type": ["string", "null"]}
      }
    }
  },
  "$defs": {
    "digest_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "ci_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "run_id", "conclusion", "git_sha"],
      "properties": {
        "workflow": {"type": "string", "minLength": 1},
        "run_id": {"type": ["integer", "string"]},
        "conclusion": {"type": "string", "enum": ["success", "failure", "cancelled", "skipped", "timed_out", "action_required"]},
        "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    }
  }
}
