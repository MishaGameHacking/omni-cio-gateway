{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omni-cio.local/schemas/v10-owner-node-profile.schema.json",
  "title": "Omni-CIO V10 OWNER_NODE_PROFILE",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "captured_at_utc",
    "capture_mode",
    "node_role",
    "privacy",
    "hardware",
    "os",
    "security",
    "time",
    "network",
    "power",
    "thermal",
    "checks",
    "thresholds_ref",
    "exit_gate"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "captured_at_utc": {"type": "string", "format": "date-time"},
    "capture_mode": {"const": "PASSIVE_READ_ONLY"},
    "node_role": {"const": "OWNER_PERSONAL_NODE"},
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serial_numbers_collected",
        "mac_or_ip_collected",
        "usernames_or_hostnames_collected",
        "secret_values_collected",
        "recovery_key_material_collected"
      ],
      "properties": {
        "serial_numbers_collected": {"const": false},
        "mac_or_ip_collected": {"const": false},
        "usernames_or_hostnames_collected": {"const": false},
        "secret_values_collected": {"const": false},
        "recovery_key_material_collected": {"const": false}
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory", "gpu", "storage"],
      "properties": {
        "cpu": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "physical_cores", "logical_processors"],
          "properties": {
            "model": {"type": "string", "minLength": 1},
            "physical_cores": {"type": "integer", "minimum": 1},
            "logical_processors": {"type": "integer", "minimum": 1}
          }
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total_gib"],
          "properties": {
            "total_gib": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "gpu": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "present",
            "vendor",
            "model",
            "vram_mib",
            "driver_version",
            "telemetry_source"
          ],
          "properties": {
            "present": {"type": "boolean"},
            "vendor": {"type": ["string", "null"]},
            "model": {"type": ["string", "null"]},
            "vram_mib": {"type": ["number", "null"], "minimum": 0},
            "driver_version": {"type": ["string", "null"]},
            "idle_temperature_c": {"type": ["number", "null"]},
            "telemetry_source": {"enum": ["NVIDIA_SMI", "WIN32_VIDEO_CONTROLLER", "UNAVAILABLE"]}
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["system_volume", "physical_disks"],
          "properties": {
            "system_volume": {
              "type": "object",
              "additionalProperties": false,
              "required": ["capacity_gib", "free_gib", "free_percent", "health_status"],
              "properties": {
                "capacity_gib": {"type": "number", "exclusiveMinimum": 0},
                "free_gib": {"type": "number", "minimum": 0},
                "free_percent": {"type": "number", "minimum": 0, "maximum": 100},
                "health_status": {"type": "string", "minLength": 1}
              }
            },
            "physical_disks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["size_gib", "media_type", "health_status", "operational_status"],
                "properties": {
                  "size_gib": {"type": "number", "exclusiveMinimum": 0},
                  "media_type": {"type": "string"},
                  "health_status": {"type": "string"},
                  "operational_status": {"type": "string"}
                }
              }
            }
          }
        }
      }
    },
    "os": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_name", "version", "build", "architecture", "last_boot_utc"],
      "properties": {
        "product_name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "build": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "last_boot_utc": {"type": "string", "format": "date-time"}
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full_disk_encryption", "firewall", "private_at_rest"],
      "properties": {
        "full_disk_encryption": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "volume_status",
            "protection_status",
            "encryption_percentage",
            "encryption_method",
            "recovery_key_custody_status"
          ],
          "properties": {
            "provider": {"enum": ["BITLOCKER", "UNAVAILABLE"]},
            "volume_status": {"type": "string"},
            "protection_status": {"type": "string"},
            "encryption_percentage": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
            "encryption_method": {"type": ["string", "null"]},
            "recovery_key_custody_status": {
              "enum": ["OWNER_CONFIRMED_SEPARATE", "OWNER_CONFIRMATION_REQUIRED", "NOT_APPLICABLE"]
            }
          }
        },
        "firewall": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profiles", "wildcard_tcp_listener_count"],
          "properties": {
            "profiles": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "enabled", "default_inbound_action", "default_outbound_action"],
                "properties": {
                  "name": {"enum": ["Domain", "Private", "Public"]},
                  "enabled": {"type": "boolean"},
                  "default_inbound_action": {"type": "string"},
                  "default_outbound_action": {"type": "string"}
                }
              }
            },
            "wildcard_tcp_listener_count": {"type": "integer", "minimum": 0}
          }
        },
        "private_at_rest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "acl_state"],
          "properties": {
            "classification": {"const": "BROKER_SECRETS_PRIVATE_DB_CORTEX_HISTORY_PRIVATE"},
            "acl_state": {"enum": ["WP6_NOT_YET_CONFIGURED", "OWNER_ONLY_BASELINE", "VERIFIED"]}
          }
        }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_status",
        "source_class",
        "measured_against",
        "offset_ms",
        "utc_policy",
        "sensitive_operation_gate"
      ],
      "properties": {
        "service_status": {"type": "string"},
        "source_class": {"enum": ["WINDOWS_NTP", "DOMAIN_HIERARCHY", "LOCAL_CLOCK", "OTHER", "UNKNOWN"]},
        "measured_against": {"const": "time.windows.com"},
        "offset_ms": {"type": ["number", "null"]},
        "utc_policy": {"const": "CANONICAL_EVENT_TIMESTAMPS_UTC"},
        "sensitive_operation_gate": {"enum": ["PASS", "BLOCK_DRIFT", "BLOCK_UNKNOWN_TIME"]}
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wired_connected", "wired_link_speed_mbps", "public_exposure_assessment"],
      "properties": {
        "wired_connected": {"type": "boolean"},
        "wired_link_speed_mbps": {"type": ["number", "null"], "minimum": 0},
        "public_exposure_assessment": {"enum": ["BASELINE_FIREWALL_ONLY_NO_V10_RUNTIME", "REVIEW_REQUIRED"]}
      }
    },
    "power": {
      "type": "object",
      "additionalProperties": false,
      "required": ["battery_present", "ac_online", "active_power_scheme", "battery_conservation", "restart_after_power_loss"],
      "properties": {
        "battery_present": {"type": "boolean"},
        "ac_online": {"type": ["boolean", "null"]},
        "active_power_scheme": {"type": "string"},
        "battery_conservation": {"enum": ["ENABLED", "DISABLED", "UNKNOWN_REQUIRES_OWNER_CHECK", "NOT_APPLICABLE"]},
        "restart_after_power_loss": {"enum": ["ENABLED", "DISABLED", "UNKNOWN_REQUIRES_FIRMWARE_CHECK"]}
      }
    },
    "thermal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acpi_zone_max_idle_c", "gpu_idle_c", "observation"],
      "properties": {
        "acpi_zone_max_idle_c": {"type": ["number", "null"]},
        "gpu_idle_c": {"type": ["number", "null"]},
        "observation": {"enum": ["PASSIVE_BASELINE", "SENSORS_PARTIAL", "SENSORS_UNAVAILABLE"]}
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disk_health", "reboot", "network_reconnect", "sustained_cpu_gpu_load"],
      "properties": {
        "disk_health": {"enum": ["PASS", "WARN", "FAIL", "UNKNOWN"]},
        "reboot": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "network_reconnect": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "sustained_cpu_gpu_load": {"enum": ["PASS", "FAIL", "NOT_RUN", "GPU_LOAD_GENERATOR_REQUIRED"]}
      }
    },
    "thresholds_ref": {"const": "infrastructure/windows/wp5_node_thresholds.json"},
    "exit_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "blocking_reasons"],
      "properties": {
        "status": {"enum": ["PASS", "BLOCKED"]},
        "blocking_reasons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
