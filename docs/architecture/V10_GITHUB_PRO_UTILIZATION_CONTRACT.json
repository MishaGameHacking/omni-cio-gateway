      "runner": "windows-latest",
      "purpose": "disposable_clean_room_windows_compatibility",
      "billing_class": "github_hosted_included_minutes",
      "run_policy": "path_aware_and_release_gated",
      "typical_work": [
        "selected_python_node_compatibility",
        "windows_dependency_lock_reproduction",
        "clean_room_tests",
        "sbom_generation",
        "bootstrap_compatibility_when_available"
      ]
    },
    {
      "id": "lenovo_authoritative",
      "runner_labels": ["self-hosted", "Windows", "X64", "omni-cio-ci"],
      "purpose": "authoritative_heavy_and_local_hardware_validation",
      "billing_class": "self_hosted_no_github_hosted_minutes",
