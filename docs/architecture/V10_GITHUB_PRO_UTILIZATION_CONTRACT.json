    "github_enterprise_required": false,
    "github_advanced_security_required": false,
    "paid_ai_api_required": false,
    "paid_search_api_required": false,
    "paid_ci_security_saas_required": false
  },
  "current_plan_reference": {
    "github_actions_hosted_minutes_per_month": 3000,
    "github_actions_storage_gb": 1,
    "github_packages_storage_gb": 2,
    "github_packages_data_transfer_gb_per_month": 10,
