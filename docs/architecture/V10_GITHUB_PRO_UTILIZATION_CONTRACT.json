{
  "contract": "V10_GITHUB_PRO_UTILIZATION_CONTRACT",
  "version": 1,
  "status": "OWNER_APPROVED_PLANNING_AUTHORITY",
  "effective_date": "2026-08-07",
  "implementation_started": false,
  "subscription_policy": {
    "github_pro": "APPROVED_PRIMARY_ENGINEERING_SUBSCRIPTION",
