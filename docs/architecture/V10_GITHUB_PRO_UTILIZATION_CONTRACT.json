        "full_deterministic_tests",
        "sast_dependency_secret_scans",
        "broker_parser_reconciliation",
        "web_e2e",
        "ollama_qwen_integration",
        "ai_evals",
        "gpu_vram_latency_benchmarks"
      ],
      "forbidden": [
        "implicit_access_to_trading_secrets",
        "implicit_access_to_private_runtime_database",
        "unreviewed_production_deployment"
      ]
    }
  ],
  "actions_budget": {
    "monthly_hosted_minutes_plan_value": 3000,
    "planning_allocation_percent": {
      "fast_pr_validation": 50,
      "clean_room_compatibility": 25,
      "release_recovery_validation": 15,
      "incident_reserve": 10
    },
    "paid_overage_required_for_definition_of_done": false,
    "quota_exhaustion_behavior": "degrade_hosted_acceleration_without_disabling_authoritative_safety_gates"
  },
  "cache_policy": {
    "included_repository_cache_gb_reference": 10,
    "allowed": [
      "pip_and_wheels",
      "npm",
      "playwright_browsers",
      "safe_build_tool_cache",
      "public_static_analysis_databases"
