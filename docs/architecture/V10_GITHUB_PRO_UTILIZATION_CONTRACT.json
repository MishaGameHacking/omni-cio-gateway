      "private_portfolio_data",
      "secrets",
      "database_backups",
      "authoritative_release_evidence",
      "large_qwen_model_weights_when_they_displace_ci_cache"
    ]
  },
  "artifact_policy": {
    "included_actions_storage_gb_reference": 1,
    "default_pr_retention_days": [1, 3],
    "prefer_job_summary_for_human_readable_diagnostics": true,
    "allowed": [
      "sbom",
      "coverage_and_test_reports",
      "sanitized_e2e_failure_media",
      "release_manifest_candidates",
      "sanitized_ai_eval_reports",
      "small_downstream_build_bundles"
