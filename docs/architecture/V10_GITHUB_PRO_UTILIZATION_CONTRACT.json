    "broker_secret_store": false,
    "private_pro_required_reviewers_assumed": false,
    "private_pro_wait_timers_assumed": false
  },
  "supply_chain": {
    "dependabot_ecosystems": ["pip", "npm", "github-actions"],
    "prefer_grouped_minor_patch_updates": true,
    "security_updates_prioritized": true,
    "auto_merge_without_v10_gates": false,
    "repository_controlled_checks": [
