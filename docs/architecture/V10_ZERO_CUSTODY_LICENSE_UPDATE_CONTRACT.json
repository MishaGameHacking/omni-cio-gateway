{
  "schema_version": "1.0.0",
  "status": "owner-approved-planning-baseline",
  "architecture": {
    "personal_node_private_state_authority": true,
    "central_portfolio_custody_allowed": false,
    "central_broker_secret_custody_allowed": false,
    "central_private_cortex_history_custody_allowed": false,
    "central_broker_proxy_by_default": false,
    "central_plane_purpose": [
      "payment_order_state",
      "license_entitlement",
      "trial_used_state",
      "signed_release_update_metadata",
      "license_anti_abuse_security_state",
      "legally_required_receipt_refund_records"
    ]
  },
  "personal_node_private_data": [
    "portfolio",
    "broker_reports",
    "broker_read_token",
    "broker_trade_token",
    "private_trading_history",
    "private_decision_journal_payload",
    "private_cortex_conversation_history",
    "local_preferences",
    "local_telegram_binding_where_feasible"
  ],
  "broker_secrets": {
    "read_token_required_for_live_mode": true,
    "trade_token_optional": true,
    "transfer_withdrawal_token_supported": false,
    "stored_in_local_secret_vault": true,
    "visible_to_cortex": false,
    "visible_to_update_agent": false,
    "visible_to_github_or_ci": false,
    "rotatable_by_owner": true
  },
  "privacy_firewall": {
    "required": true,
    "purpose": "prevent unnecessary private portfolio/account context from leaving the Personal Node during research telemetry or updates",
    "default_deny_private_fields": [
      "broker_account_id",
      "broker_tokens",
      "full_portfolio_value",
      "private_trade_history",
      "private_report_content",
      "user_identity_fields_not_required_by_destination"
    ]
  },
  "commercial_access": {
    "trial_days": 7,
    "trial_feature_level": "FULL_SUBJECT_TO_NORMAL_SAFETY_AND_LEGAL_GATES",
    "fixed_terms_months": [1, 3, 6, 12],
    "auto_renewal": false,
    "recurring_charge": false,
    "saved_payment_method_required": false,
    "renewal_requires_explicit_new_user_payment": true,
    "prices_defined_in_contract": false
  },
  "license_identity": {
    "central_full_user_profile_required": false,
    "node_cryptographic_identity_required": true,
    "trial_resists_simple_reinstall": true,
    "local_clock_is_authoritative_for_expiry": false,
    "recovery_or_transfer_mechanism_required": true,
    "central_state_minimization_required": true
  },
  "license_states": [
    "TRIAL_ACTIVE",
    "ACTIVE",
    "EXPIRING",
    "OFFLINE_GRACE",
    "EXPIRED",
    "PAYMENT_PENDING",
    "SUSPENDED",
    "REVOKED",
    "LICENSE_SERVER_UNAVAILABLE",
    "UPDATE_REQUIRED"
  ],
  "expiry_behavior": {
    "delete_user_private_data": false,
    "automatic_charge": false,
    "may_disable": [
      "new_live_broker_updates",
      "cortex",
      "new_research",
      "watchtower_automation",
      "telegram_automation",
      "new_analytics_jobs",
      "real_buy_sell_execution"
    ],
    "must_remain_available": [
      "license_status_and_renewal",
      "data_export",
      "broker_secret_remove_or_rotate",
      "local_data_delete_controls",
      "legal_privacy_documents",
      "recovery",
      "update_agent"
    ]
  },
  "automatic_updates": {
    "stable_updates_required_for_supported_active_nodes": true,
    "manual_installer_download_normal_path": false,
    "permanent_obsolete_version_pin_supported": false,
    "release_must_pass_repository_gates_before_promotion": true,
    "internal_or_test_node_validation_before_stable": true,
    "signed_metadata_required": true,
    "artifact_digest_verification_required": true,
    "rollback_freeze_attack_protection_required": true,
    "atomic_or_staged_install_required": true,
    "post_update_health_check_required": true,
    "automatic_rollback_on_failed_health": true,
    "real_execution_paused_during_unsafe_update_window": true,
    "arbitrary_remote_command_from_update_metadata_allowed": false,
    "update_agent_survives_subscription_expiry": true,
    "renewed_node_must_converge_to_supported_version_before_full_resume": true
  },
  "update_states": [
    "CURRENT",
    "UPDATE_AVAILABLE",
    "UPDATE_DOWNLOADING",
    "UPDATE_STAGED",
    "UPDATING",
    "UPDATE_FAILED_ROLLBACK",
    "UPDATE_REQUIRED"
  ],
  "legal_boundary": {
    "zero_custody_means_no_possible_personal_data_processing": false,
    "central_data_inventory_required_before_production": true,
    "operator_notification_localization_and_retention_determination_required": true,
    "commercial_legal_signoff_required": true
  }
}
